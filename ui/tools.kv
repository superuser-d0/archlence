#:import ftheme ui.theme
#:import PassthroughScrollView ui.components.PassthroughScrollView
#:set AMBER (0.85, 0.62, 0.25, 1)

<BudgetPlannerPanel@MDCard>:
    elevation: 0
    line_color: ftheme.card_line(app.theme_cls.theme_style)
    orientation: "vertical"
    padding: "16dp"
    spacing: "10dp"
    size_hint_y: None

    height: max(dp(400), self.minimum_height + dp(40))
    radius: [24, 24, 24, 24]
    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)

    MDBoxLayout:
        size_hint_y: None
        height: "30dp"
        spacing: "10dp"
        MDIcon:
            id: projection_icon
            icon: "calendar-month"
            size_hint_x: None
            width: "28dp"
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color
            font_size: "24sp"
        MDLabel:
            text: app.tr("Aylık Bütçe Planı", app.language)
            font_style: "H6"
            bold: True
        MDIconButton:
            icon: "calendar-check"
            size_hint_x: None
            width: "48dp"
            tooltip_text: app.tr("Bu planı yıl sonuna kadar uygula", app.language)
            pos_hint: {"center_y": .5}
            on_release: app.confirm_plan_as_current()
        MDIconButton:
            icon: "chart-timeline-variant"
            size_hint_x: None
            width: "48dp"
            tooltip_text: app.tr("Geçmiş / Trend", app.language)
            pos_hint: {"center_y": .5}
            on_release: app.show_budget_trend()
        MDIconButton:
            icon: "pencil-outline"
            size_hint_x: None
            width: "48dp"
            pos_hint: {"center_y": .5}

            on_release: app.open_budget_item_form()

    PassthroughScrollView:
        do_scroll_y: False
        do_scroll_x: True
        size_hint_y: None
        height: "40dp"

        MDBoxLayout:
            id: month_selector_container
            orientation: "horizontal"
            adaptive_width: True
            spacing: "10dp"

    MDLabel:
        id: projection_label
        text: app.tr("Ay seçin ve plan oluşturun...", app.language)
        theme_text_color: "Secondary"
        font_style: "Body2"
        halign: "left"
        valign: "top"
        text_size: self.width, None

    ScrollView:
        size_hint_y: 1
        MDBoxLayout:
            id: budget_detailed_list
            orientation: 'vertical'
            adaptive_height: True
            spacing: '5dp'

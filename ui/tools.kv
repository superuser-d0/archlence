#:import ftheme ui.theme
#:set AMBER (0.85, 0.62, 0.25, 1)

# ARAÇLAR SEKMESİ BİLEŞENLERİ
#
# NEDEN AYRI DOSYA: Aylık Bütçe Planı kartı ui/dashboard.kv içinde ~1640.
# satırda, altı seviye iç içe bir ağacın ortasında duruyordu. O dosya bu
# projede iki kez girinti kazasıyla uygulamanın hiç açılmamasına yol açtı;
# panel kendi dosyasında ve tek bir girinti tabanında çok daha güvenli.
#
# DİKKAT — id ERİŞİMİ: Dinamik sınıf kuralı içindeki id'ler bu bileşenin
# KENDİ `ids` sözlüğünde yaşar, uygulamanın `root.ids`'inde DEĞİL. Python
# tarafı bu yüzden BudgetMixin._planner_ids() üzerinden erişiyor.
<BudgetPlannerPanel@MDCard>:
    elevation: 0
    line_color: ftheme.card_line(app.theme_cls.theme_style)
    orientation: "vertical"
    padding: "16dp"
    spacing: "10dp"
    size_hint_y: None
    height: "400dp"
    radius: [24, 24, 24, 24]
    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)

    MDBoxLayout:
        size_hint_y: None
        height: "30dp"
        spacing: "10dp"
        MDIcon:
            id: projection_icon
            icon: "calendar-month"
            size_hint_x: None
            width: "28dp"
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color
            font_size: "24sp"
        MDLabel:
            text: app.tr("Aylık Bütçe Planı", app.language)
            font_style: "H6"
            bold: True
        MDIconButton:
            icon: "chart-timeline-variant"
            size_hint_x: None
            width: "48dp"
            tooltip_text: app.tr("Geçmiş / Trend", app.language)
            pos_hint: {"center_y": .5}
            on_release: app.show_budget_trend()
        MDIconButton:
            icon: "pencil-outline"
            size_hint_x: None
            width: "48dp"
            pos_hint: {"center_y": .5}
            on_release: app.show_budget_planner()

    # YENİ: Yatay Ay Seçici
    ScrollView:
        do_scroll_y: False
        do_scroll_x: True
        size_hint_y: None
        height: "40dp"

        MDBoxLayout:
            id: month_selector_container
            orientation: "horizontal"
            adaptive_width: True
            spacing: "10dp"

            # Dinamik Olarak Python Tarafından Doldurulacak

    MDLabel:
        id: projection_label
        text: app.tr("Ay seçin ve plan oluşturun...", app.language)
        theme_text_color: "Secondary"
        font_style: "Body2"
        halign: "left"
        valign: "top"
        text_size: self.width, None

    # DETAYLI LİSTE ALANI
    ScrollView:
        size_hint_y: 1
        MDBoxLayout:
            id: budget_detailed_list
            orientation: 'vertical'
            adaptive_height: True
            spacing: '5dp'


# ANA SAYFA BÜTÇE ÖZET KARTI (minimal iskelet)
#
# Ayrıntılı planlayıcı Araçlar sekmesinde; ana sayfa yalnız "bu ay ne kadarını
# harcadım" sorusunu tek bakışta yanıtlar. Değerler
# BudgetMixin.refresh_budget_summary tarafından yazılır (veri köprüsü).
# GEMINI: görsel cilalama (renk paleti, padding, font boyutu) bu kuralda.
<BudgetSummaryCard@MDCard>:
    elevation: 0
    line_color: ftheme.card_line(app.theme_cls.theme_style)
    orientation: "vertical"
    padding: "16dp"
    spacing: "8dp"
    size_hint_y: None
    height: "150dp"
    radius: [24, 24, 24, 24]
    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)

    MDBoxLayout:
        size_hint_y: None
        height: "30dp"
        spacing: "10dp"
        MDIcon:
            icon: "wallet-outline"
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color
            font_size: "24sp"
        MDLabel:
            text: app.tr("Aylık Bütçe", app.language)
            font_style: "H6"
            bold: True

    MDLabel:
        id: budget_summary_text
        text: app.tr("Bütçe planı hazırlanıyor...", app.language)
        theme_text_color: "Secondary"
        font_style: "Body2"
        size_hint_y: None
        height: "44dp"
        text_size: self.width, None

    MDProgressBar:
        id: budget_summary_bar
        value: 0
        max: 100
        size_hint_y: None
        height: "8dp"

    MDFlatButton:
        text: app.tr("PLANLAYICIYI AÇ", app.language)
        pos_hint: {"center_x": .5}
        theme_text_color: "Custom"
        text_color: app.theme_cls.primary_color
        on_release: app.show_budget_planner()

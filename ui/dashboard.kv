                                        icon: "chevron-right"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Hint"

                                MDSeparator:

                                # --- VERİLER VE GİZLİLİK ---
                                ClickableSettingsRow:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    on_release: app.show_data_privacy_dialog()
                                    MDIcon:
                                        icon: "shield-account-outline"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDLabel:
                                        text: "Veriler ve Gizlilik"
                                        theme_text_color: "Primary"
                                    MDIcon:
                                        icon: "chevron-right"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Hint"

                                MDSeparator:

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    MDIcon:
                                        icon: "moon-waning-crescent"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDLabel:
                                        text: "Karanlık Mod"
                                        theme_text_color: "Primary"
                                    MDSwitch:
                                        size_hint_x: None
                                        width: "52dp"
                                        pos_hint: {"center_y": .5}
                                        icon_active: "check"
                                        icon_inactive: "close"
                                        active: True if app.theme_cls.theme_style == "Dark" else False
                                        on_active: app.toggle_theme(self.active)
                                
                                MDSeparator:
                                
                                ClickableSettingsRow:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    on_release: app.contact_us()
                                    MDIcon:
                                        icon: "email-outline"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDLabel:
                                        text: "Bize Ulaşın"
                                        theme_text_color: "Primary"
                                    MDIcon:
                                        icon: "chevron-right"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Hint"
                                
                                MDSeparator:

                                ClickableSettingsRow:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    on_release: screen_manager.current = "login"
                                    MDIcon:
                                        icon: "logout"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Error"
                                    MDLabel:
                                        text: "Çıkış Yap"
                                        theme_text_color: "Error"
                                    MDIcon:
                                        icon: "chevron-right"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Hint"

                                MDSeparator:
                        Widget:

        # --- KATEGORİ AYARLARI (ALT SAYFA) ---
        MDScreen:
            name: "category_settings"
            on_enter: app.load_categories('income')
            MDBoxLayout:
                orientation: "vertical"
                MDTopAppBar:
                    title: "Kategori Ayarları"
                    left_action_items: [["arrow-left", lambda x: setattr(screen_manager, 'current', 'home')]]
                    elevation: 4
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "48dp"
                    padding: ["16dp", "8dp", "16dp", "8dp"]
                    spacing: "16dp"
                    MDFillRoundFlatButton:
                        text: "Gelir"
                        size_hint_x: 1
                        md_bg_color: app.theme_cls.primary_color if app.active_category_type == 'income' else app.theme_cls.bg_darkest
                        text_color: (1, 1, 1, 1) if app.active_category_type == 'income' else app.theme_cls.text_color
                        on_release: app.load_categories('income')
                    MDFillRoundFlatButton:
                        text: "Gider"
                        size_hint_x: 1
                        md_bg_color: app.theme_cls.primary_color if app.active_category_type == 'expense' else app.theme_cls.bg_darkest
                        text_color: (1, 1, 1, 1) if app.active_category_type == 'expense' else app.theme_cls.text_color
                        on_release: app.load_categories('expense')
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "40dp"
                    padding: "15dp", 0, "40dp", 0
                    MDLabel:
                        text: "Kategori Adı"
                        bold: True
                    MDLabel:
                        text: "Ana Kaynak Mı?"
                        bold: True
                        halign: "right"
                ScrollView:
                    MDBoxLayout:
                        id: settings_list
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
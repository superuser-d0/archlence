                                            font_style: "Subtitle1"
                                            bold: True

                # ==== 4. SEKME: AYARLAR ====
                MDBottomNavigationItem:
                    name: "settings_tab"
                    text: app.tr("Ayarlar", app.language)
                    icon: "cog-outline"
                    
                    MDBoxLayout:
                        orientation: "vertical"
                        MDTopAppBar:
                            title: app.tr("Ayarlar", app.language)
                            elevation: 4
                        
                        ScrollView:
                            do_scroll_x: False
                            MDBoxLayout:
                                orientation: "vertical"
                                adaptive_height: True

                                MDSeparator:

                                ClickableSettingsRow:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    on_release: screen_manager.current = "category_settings"
                                    MDIcon:
                                        icon: "tag-multiple"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDLabel:
                                        text: app.tr("Kategori Ayarları", app.language)
                                        theme_text_color: "Primary"
                                    MDIcon:
                                        icon: "chevron-right"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Hint"

                                MDLabel:
                                    text: "Archlence v" + app.version
                                    halign: "center"
                                    theme_text_color: "Hint"
                                    font_style: "Caption"
                                    size_hint_y: None
                                    height: "40dp"

                                MDSeparator:

                                ClickableSettingsRow:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    on_release: app.open_language_dialog()
                                    MDIcon:
                                        icon: "translate"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDBoxLayout:
                                        orientation: "vertical"
                                        MDLabel:
                                            text: app.tr("Dil", app.language)
                                            theme_text_color: "Primary"
                                        MDLabel:
                                            text: "English" if app.language == "en" else "Türkçe"
                                            font_style: "Caption"
                                            theme_text_color: "Secondary"
                                    MDIcon:
                                        icon: "chevron-right"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Hint"

                                MDSeparator:

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "72dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    MDIcon:
                                        icon: "key-variant"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDBoxLayout:
                                        orientation: "vertical"

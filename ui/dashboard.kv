                                        size_hint_y: None
                                        height: "140dp"
                                        radius: [24]
                                        md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)
                                        orientation: "vertical"
                                        padding: "20dp"
                                        spacing: "10dp"

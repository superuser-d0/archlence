                                            text: app.tr("Şifreleme Anahtarı", app.language)
                                            theme_text_color: "Primary"
                                        MDLabel:
                                            text: app.key_protection_text
                                            font_style: "Caption"
                                            theme_text_color: "Secondary"

                                MDSeparator:

                                # --- GÖRÜNÜM AYARLARI ---
                                MDLabel:
                                    text: app.tr("Görünüm Ayarları", app.language)
                                    font_style: "Caption"
                                    bold: True
                                    theme_text_color: "Secondary"
                                    size_hint_y: None
                                    height: "32dp"
                                    padding: ["20dp", 0]
                                    valign: "bottom"

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    MDIcon:
                                        icon: "palette-outline"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDBoxLayout:
                                        orientation: "vertical"
                                        MDLabel:
                                            text: app.tr("Premium Mavi Tema", app.language)
                                            theme_text_color: "Primary"
                                        MDLabel:
                                            text: app.tr("Kapalıyken standart tema kullanılır", app.language)
                                            font_style: "Caption"
                                            theme_text_color: "Secondary"
                                    MDSwitch:
                                        size_hint_x: None
                                        width: "52dp"
                                        pos_hint: {"center_y": .5}
                                        icon_active: "check"
                                        icon_inactive: "close"
                                        active: app.theme_name == "premium"
                                        on_active: app.apply_theme("premium" if self.active else "standard")

                                MDSeparator:

                                # --- VERİLER VE GİZLİLİK ---
                                ClickableSettingsRow:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    on_release: app.show_data_privacy_dialog()
                                    MDIcon:
                                        icon: "shield-account-outline"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDLabel:
                                        text: app.tr("Veriler ve Gizlilik", app.language)
                                        theme_text_color: "Primary"
                                    MDIcon:
                                        icon: "chevron-right"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Hint"

                                MDSeparator:

                                # --- ŞİFRE DEĞİŞTİR ---
                                ClickableSettingsRow:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    on_release: app.open_change_pin_dialog()
                                    MDIcon:
                                        icon: "key-change"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDBoxLayout:
                                        orientation: "vertical"
                                        pos_hint: {"center_y": .5}
                                        MDLabel:
                                            text: app.tr("Şifre Değiştir", app.language)
                                            theme_text_color: "Primary"
                                            size_hint_y: None
                                            height: "20dp"
                                        MDLabel:
                                            text: app.tr("Şifrenizi buradan yenileyebilirsiniz.", app.language)
                                            font_style: "Caption"
                                            theme_text_color: "Secondary"
                                            size_hint_y: None
                                            height: "16dp"
                                    MDIcon:
                                        icon: "chevron-right"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Hint"

                                MDSeparator:

                                # --- BAKİYE GEÇMİŞİ (Faz 2 zaman makinesi) ---
                                ClickableSettingsRow:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    on_release: app.show_balance_history_dialog()
                                    MDIcon:
                                        icon: "history"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDLabel:
                                        text: app.tr("Bakiye Geçmişi", app.language)
                                        theme_text_color: "Primary"
                                    MDIcon:
                                        icon: "chevron-right"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Hint"

                                MDSeparator:

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    MDIcon:
                                        icon: "moon-waning-crescent"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDLabel:
                                        text: app.tr("Karanlık Mod", app.language)
                                        theme_text_color: "Primary"
                                    MDSwitch:
                                        size_hint_x: None
                                        width: "52dp"
                                        pos_hint: {"center_y": .5}
                                        icon_active: "check"
                                        icon_inactive: "close"
                                        active: True if app.theme_cls.theme_style == "Dark" else False
                                        on_active: app.toggle_theme(self.active)
                                
                                MDSeparator:
                                
                                ClickableSettingsRow:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    on_release: app.contact_us()
                                    MDIcon:
                                        icon: "email-outline"
                                        size_hint_x: None
                                        width: "36dp"
                                        halign: "center"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Primary"
                                    MDLabel:
                                        text: app.tr("Bize Ulaşın", app.language)
                                        theme_text_color: "Primary"
                                    MDIcon:
                                        icon: "chevron-right"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Hint"
                                
                                MDSeparator:

                                ClickableSettingsRow:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "64dp"
                                    padding: ["20dp", 0, "20dp", 0]
                                    spacing: "20dp"
                                    on_release: screen_manager.current = "login"
                                    MDIcon:
                                        icon: "logout"
                                        # Genişlik AÇIKÇA veriliyor: verilmezse
                                        # kutu 0px kalıyor ve 30px'lik glif
                                        # "Çıkış Yap" yazısının üstüne biniyor
                                        # (kart başlıklarında düzeltilen kusurun
                                        # aynısı; ölçüm dedektörüyle bulundu).
                                        size_hint_x: None
                                        width: "24dp"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Error"
                                    MDLabel:
                                        text: app.tr("Çıkış Yap", app.language)
                                        theme_text_color: "Error"
                                    MDIcon:
                                        icon: "chevron-right"
                                        pos_hint: {"center_y": .5}
                                        theme_text_color: "Hint"

                                MDSeparator:

        # --- KATEGORİ AYARLARI (ALT SAYFA) ---
        MDScreen:
            name: "category_settings"
            on_enter: app.load_categories('income')
            MDBoxLayout:
                orientation: "vertical"
                MDTopAppBar:
                    title: app.tr("Kategori Ayarları", app.language)
                    left_action_items: [["arrow-left", lambda x: setattr(screen_manager, 'current', 'home')]]
                    elevation: 4
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "48dp"
                    padding: ["16dp", "8dp", "16dp", "8dp"]
                    spacing: "16dp"
                    MDFillRoundFlatButton:
                        text: app.tr("Gelir", app.language)
                        size_hint_x: 1
                        md_bg_color: app.theme_cls.primary_color if app.active_category_type == 'income' else ftheme.inactive_control_bg(app.theme_cls.theme_style)
                        text_color: ftheme.on_primary(app.theme_cls.theme_style) if app.active_category_type == 'income' else ftheme.inactive_control_text(app.theme_cls.theme_style)
                        on_release: app.load_categories('income')
                    MDFillRoundFlatButton:
                        text: app.tr("Gider", app.language)
                        size_hint_x: 1
                        md_bg_color: app.theme_cls.primary_color if app.active_category_type == 'expense' else ftheme.inactive_control_bg(app.theme_cls.theme_style)
                        text_color: ftheme.on_primary(app.theme_cls.theme_style) if app.active_category_type == 'expense' else ftheme.inactive_control_text(app.theme_cls.theme_style)
                        on_release: app.load_categories('expense')
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "40dp"
                    padding: "15dp", 0, "40dp", 0
                    MDLabel:
                        text: app.tr("Kategori Adı", app.language)
                        bold: True
                    MDLabel:
                        text: app.tr("Ana Kaynak Mı?", app.language)
                        bold: True
                        halign: "right"
                ScrollView:
                    MDBoxLayout:
                        id: settings_list
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height

                                                MDFillRoundFlatButton:
                                                    id: btn_filter_week
                                                    text: "1 Hafta"
                                                    size_hint_x: 0.2
                                                    md_bg_color: 0.9, 0.9, 0.9, 1
                                                    text_color: 0.5, 0.5, 0.5, 1
                                                    on_release: app.change_home_filter("1 Hafta")
                                                
                                                MDFillRoundFlatButton:
                                                    id: btn_filter_month
                                                    text: "1 Ay"
                                                    size_hint_x: 0.2
                                                    md_bg_color: 0.9, 0.9, 0.9, 1
                                                    text_color: 0.5, 0.5, 0.5, 1
                                                    on_release: app.change_home_filter("1 Ay")
                                                
                                                MDFillRoundFlatButton:

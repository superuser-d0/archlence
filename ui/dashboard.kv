#:import FadeTransition kivy.uix.screenmanager.FadeTransition
#:import Window kivy.core.window.Window
#:import LiquidWaveWidget ui.charts.LiquidWaveWidget
#:import RecycleListRow ui.components.RecycleListRow

# --- 0. GLOBAL WIDGET KURALLARI ---
<MDBottomNavigationBar>:
    elevation: 0
    shadow_softness: 0

# --- 1. ÖZEL LİSTE ELEMANLARI VE KURALLAR ---
<LegendItem>:
    orientation: "horizontal"
    size_hint_y: None
    height: "24dp"
    MDIcon:
        icon: "circle"
        theme_text_color: "Custom"
        text_color: root.color
    MDLabel:
        text: root.text
        theme_text_color: "Primary"

<CategorySettingItem>:
    orientation: "horizontal"
    size_hint_y: None
    height: "56dp"
    padding: ["15dp", 0, "40dp", 0]
    spacing: "10dp"
    
    MDLabel:
        text: root.cat_name
        theme_text_color: "Primary"
    MDSwitch:
        size_hint_x: None
        width: "52dp"
        pos_hint: {"center_y": .5}
        icon_active: "check"
        icon_inactive: "close"
        active: True if root.cat_importance == 'main' else False
        on_active: app.update_category_importance(root.cat_name, self.active)

<ClickableSettingsRow@ButtonBehavior+MDBoxLayout>:

<BudgetListItem>:
    text: ""
    secondary_text: ""
    
    IconLeftWidget:
        icon: "cash-plus" if "Gelir" in root.secondary_text else "cash-minus"
        theme_text_color: "Custom"
        text_color: (0.18, 0.8, 0.25, 1) if "Gelir" in root.secondary_text else (0.9, 0.2, 0.2, 1)

<AdminScreen@MDScreen>:
    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            title: "Sistem Yönetimi (Admin)"
            left_action_items: [["logout", lambda x: app.admin_logout()]]
            elevation: 4
        
        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                padding: "20dp"
                spacing: "20dp"
                adaptive_height: True

                MDCard:
                    orientation: "vertical"
                    padding: "16dp"
                    spacing: "10dp"
                    size_hint_y: None
                    height: "120dp"
                    elevation: 2
                    radius: [15]
                    
                    MDLabel:
                        text: "Veritabanı Durumu"
                        font_style: "H6"
                        bold: True
                    
                    MDLabel:
                        id: stats_label
                        text: "Toplam İşlem Kaydı: ...\nToplam Bütçe Kalemi: ..."
                        theme_text_color: "Secondary"
                
                MDRaisedButton:
                    text: "Veritabanını Dışa Aktar (CSV)"
                    icon: "export"
                    size_hint_x: 1
                    md_bg_color: app.theme_cls.primary_color
                    on_release: root.export_to_csv()
                
                MDRaisedButton:
                    text: "Sistemi Sıfırla (Factory Reset)"
                    icon: "delete-forever"
                    size_hint_x: 1
                    md_bg_color: 0.9, 0.2, 0.2, 1
                    on_release: root.confirm_factory_reset()

        Widget:

# --- 2. ANA ARAYÜZ İSKELETİ ---
MDScreen:
    md_bg_color: app.theme_cls.bg_normal

    MDScreenManager:
        id: screen_manager
        transition: FadeTransition(duration=0.2)

        # --- GİRİŞ EKRANI ---
        MDScreen:
            name: "login"
            MDFloatLayout:
                MDIconButton:
                    icon: "cog"
                    pos_hint: {"top": 0.98, "right": 0.98}
                    theme_text_color: "Hint"
                    on_release: screen_manager.current = "pre_login_settings"

                MDBoxLayout:
                    orientation: "vertical"
                    padding: "40dp"
                    spacing: "20dp"
                    pos_hint: {"center_x": .5, "center_y": .5}
                    size_hint_y: None
                    height: "480dp"

                    MDLabel:
                        text: "FINORA"
                        font_style: "H3"
                        halign: "center"
                        theme_text_color: "Primary"
                        bold: True

                    MDLabel:
                        text: "Güvenli Giriş"
                        font_style: "Subtitle1"
                        halign: "center"
                        theme_text_color: "Secondary"

                    MDTextField:
                        id: username_input
                        hint_text: "Kullanıcı Adı"
                        icon_right: "account"
                        size_hint_x: 0.8
                        pos_hint: {"center_x": .5}
                        multiline: False
                        write_tab: False

                    MDRelativeLayout:
                        id: password_container
                        size_hint_x: 0.8
                        pos_hint: {"center_x": .5}
                        size_hint_y: None
                        height: password_input.height

                        MDTextField:
                            id: password_input
                            hint_text: "Şifre"
                            password: True
                            multiline: False
                            write_tab: False
                            on_text_validate: app.check_login()

                        MDIconButton:
                            icon: "eye-off"
                            pos_hint: {"center_y": .5}
                            pos: password_input.width - self.width, 0
                            theme_text_color: "Hint"
                            on_release:
                                self.icon = "eye" if self.icon == "eye-off" else "eye-off"
                                password_input.password = False if password_input.password is True else True

                    MDTextButton:
                        text: "Şifreni mi unuttun?"
                        theme_text_color: "Hint"
                        pos_hint: {"center_x": .5}
                        on_release: screen_manager.current = "forgot_password"

                    MDLabel:
                        id: login_error_label
                        text: ""
                        theme_text_color: "Error"
                        halign: "center"
                        size_hint_y: None
                        height: "20dp"

                    MDRaisedButton:
                        text: "GİRİŞ YAP"
                        size_hint_x: 0.5
                        pos_hint: {"center_x": .5}
                        on_release: app.check_login()
                        
                    MDTextButton:
                        text: "Finora'da yeni misin? Hemen bir hesap oluştur."
                        theme_text_color: "Primary"
                        pos_hint: {"center_x": .5}

                    Widget:

        # --- ŞİFREMİ UNUTTUM EKRANI ---
        MDScreen:
            name: "forgot_password"
            MDBoxLayout:
                orientation: "vertical"
                MDTopAppBar:
                    title: "Şifre Sıfırlama"
                    left_action_items: [["arrow-left", lambda x: setattr(screen_manager, 'current', 'login')]]
                    elevation: 4
                
                MDBoxLayout:
                    orientation: "vertical"
                    padding: "40dp"
                    spacing: "30dp"
                    pos_hint: {"center_x": .5, "center_y": .6}
                    size_hint_y: None
                    height: "350dp"

                    MDLabel:
                        text: "Finora hesabınıza bağlı olan\ne-posta adresini giriniz."
                        halign: "center"
                        font_style: "Subtitle1"
                        theme_text_color: "Primary"

                    MDTextField:
                        hint_text: "ornek@finora.com"
                        icon_right: "email"
                        size_hint_x: 0.8
                        pos_hint: {"center_x": .5}
                        mode: "rectangle"

                    MDRaisedButton:
                        text: "ŞİFRE AL"
                        size_hint_x: 0.5
                        pos_hint: {"center_x": .5}

                    Widget:
                Widget:

        # --- GİRİŞ ÖNCESİ AYARLAR EKRANI ---
        MDScreen:
            name: "pre_login_settings"
            MDBoxLayout:
                orientation: "vertical"
                MDTopAppBar:
                    title: "Ayarlar"
                    left_action_items: [["arrow-left", lambda x: setattr(screen_manager, 'current', 'login')]]
                    elevation: 4
                
                ScrollView:
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        MDSeparator:
                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: "64dp"
                            padding: ["20dp", 0, "20dp", 0]
                            spacing: "20dp"
                            MDIcon:
                                icon: "moon-waning-crescent"
                                size_hint_x: None
                                width: "36dp"
                                halign: "center"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Primary"
                            MDLabel:
                                text: "Karanlık Mod"
                                theme_text_color: "Primary"
                            MDSwitch:
                                size_hint_x: None
                                width: "52dp"
                                pos_hint: {"center_y": .5}
                                icon_active: "check"
                                icon_inactive: "close"
                                active: True if app.theme_cls.theme_style == "Dark" else False
                                on_active: app.toggle_theme(self.active)
                        MDSeparator:
                Widget:

        # --- YÖNETİCİ EKRANI ---
        AdminScreen:
            name: "admin"

        # --- ANA UYGULAMA (SABİT ALT SEKMELER - BOTTOM NAVIGATION) ---
        MDScreen:
            name: "home"

            MDBottomNavigation:
                id: bottom_nav
                transition_duration: 0.4
                selected_color_background: 0, 0, 0, 0
                text_color_active: app.theme_cls.primary_color
                panel_color: app.theme_cls.bg_normal

                # ==== 1. SEKME: ANA SAYFA ====
                MDBottomNavigationItem:
                    name: "home_tab"
                    text: "Ana Sayfa"
                    icon: "home-variant"
                    
                    MDBoxLayout:
                        orientation: "vertical"
                        
                        MDBoxLayout:
                            size_hint_y: None
                            height: "72dp"
                            padding: ["16dp", "10dp", "16dp", "10dp"]
                            spacing: "15dp"
                            
                            MDIconButton:
                                icon: "account-circle"
                                icon_size: "36dp"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Primary"
                                on_release: bottom_nav.switch_tab("settings_tab")
                                
                            MDTextField:
                                hint_text: "Finora'da ara..."
                                icon_left: "magnify"
                                mode: "round"
                                size_hint_y: None
                                height: "40dp"
                                pos_hint: {"center_y": .5}
                                
                            MDIconButton:
                                icon: "bell-outline"
                                icon_size: "28dp"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Primary"

                        ScrollView:
                            MDBoxLayout:
                                orientation: "vertical"
                                padding: ["20dp", "10dp", "20dp", "20dp"]
                                spacing: "20dp"
                                size_hint_y: None
                                height: self.minimum_height

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "40dp"
                                    pos_hint: {"center_x": .5}
                                    adaptive_width: True
                                    spacing: "8dp"
                                    
                                    MDIcon:
                                        icon: "wallet"
                                        theme_text_color: "Secondary"
                                        pos_hint: {"center_y": .5}
                                    MDLabel:
                                        text: "Cüzdanım"
                                        font_style: "Subtitle1"
                                        bold: True
                                        adaptive_width: True
                                        pos_hint: {"center_y": .5}
                                    MDIcon:
                                        icon: "chevron-down"
                                        theme_text_color: "Secondary"
                                        pos_hint: {"center_y": .5}

                                MDRelativeLayout:
                                    size_hint: None, None
                                    size: "240dp", "240dp"
                                    pos_hint: {"center_x": .5}

                                    MDFloatLayout:
                                        id: balance_circle
                                        canvas.before:
                                            Color:
                                                rgba: app.home_circle_color
                                            Line:
                                                width: 2.5
                                                circle: (self.center_x, self.center_y, dp(115))

                                    MDBoxLayout:
                                        orientation: "vertical"
                                        size_hint: None, None
                                        size: "220dp", "150dp"
                                        pos_hint: {"center_x": .5, "center_y": .5}
                                        spacing: "10dp"

                                        MDLabel:
                                            text: "Toplam Bakiye"
                                            halign: "center"
                                            theme_text_color: "Secondary"

                                        MDLabel:
                                            id: home_total_balance
                                            text: "0,00 ₺" 
                                            font_style: "H5"
                                            bold: True
                                            halign: "center"
                                            theme_text_color: "Primary"

                                        MDBoxLayout:
                                            orientation: "horizontal"
                                            adaptive_size: True
                                            pos_hint: {"center_x": .5}
                                            spacing: "10dp"
                                            
                                            MDLabel:
                                                id: change_rate_label
                                                text: "%0.0"
                                                font_size: "14sp"
                                                theme_text_color: "Custom"
                                                text_color: 0.13, 0.59, 0.95, 1
                                                adaptive_width: True
                                            MDIcon:
                                                icon: "chart-line-variant"
                                                theme_text_color: "Custom"
                                                text_color: 0.13, 0.59, 0.95, 1
                                                font_size: "16sp"
                                                pos_hint: {"center_y": .5}
                                                
                                        MDLabel:
                                            id: home_change_title
                                            text: "Aylık Gider Değişimi"
                                            halign: "center"
                                            font_size: "12sp"
                                            theme_text_color: "Secondary"

                                # NEGATİF BAKİYE UYARISI: toplam nakit bakiye 0'ın altına
                                # düştüğünde görünür olur, artıya dönünce tekrar gizlenir
                                # (bkz. main.py update_metrics_and_goals).
                                MDBoxLayout:
                                    id: negative_balance_warning
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: 0
                                    opacity: 0
                                    spacing: "6dp"
                                    pos_hint: {"center_x": .5}

                                    MDIcon:
                                        icon: "alert-circle"
                                        theme_text_color: "Error"
                                        font_size: "16sp"
                                        pos_hint: {"center_y": .5}
                                    MDLabel:
                                        id: negative_balance_label
                                        text: "Dikkat: Bakiye Negatif!"
                                        theme_text_color: "Error"
                                        font_style: "Caption"
                                        bold: True
                                        adaptive_width: True
                                        pos_hint: {"center_y": .5}

                                # ZAMAN FİLTRESİ
                                MDSegmentedControl:
                                    pos_hint: {"center_x": .5}
                                    size_hint_x: 0.9
                                    md_bg_color: (0.15, 0.15, 0.15, 1) if app.theme_cls.theme_style == "Dark" else (0.9, 0.9, 0.9, 1)
                                    segment_color: (0.3, 0.3, 0.3, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)
                                    on_active: app.change_home_filter(args[1].text)
                                    MDSegmentedControlItem:
                                        text: "Bugün"
                                    MDSegmentedControlItem:
                                        text: "1 Hafta"
                                    MDSegmentedControlItem:
                                        text: "1 Ay"
                                    MDSegmentedControlItem:
                                        text: "1 Yıl"

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "100dp"
                                    spacing: "15dp"

                                    MDCard:
                                        padding: "15dp"
                                        radius: [16]
                                        elevation: 0
                                        md_bg_color: (0.1, 0.1, 0.1, 0.5) if app.theme_cls.theme_style == "Dark" else (0.9, 0.9, 0.9, 0.5)
                                        orientation: "vertical"
                                        
                                        MDLabel:
                                            id: today_card_title
                                            text: "Bugün"
                                            font_size: "14sp"
                                            theme_text_color: "Secondary"
                                        MDLabel:
                                            id: today_card_amount
                                            text: "0,0 ₺"
                                            font_style: "Subtitle1"
                                            bold: True

                                    MDCard:
                                        padding: "15dp"
                                        radius: [16]
                                        elevation: 0
                                        md_bg_color: (0.1, 0.1, 0.1, 0.5) if app.theme_cls.theme_style == "Dark" else (0.9, 0.9, 0.9, 0.5)
                                        orientation: "vertical"
                                        
                                        MDLabel:
                                            text: "Toplam"
                                            font_size: "14sp"
                                            theme_text_color: "Secondary"
                                        MDLabel:
                                            id: total_card_amount
                                            text: "0,0 ₺"
                                            font_style: "Subtitle1"
                                            bold: True

                                # YENİ: MATEMATİKSEL ÖNGÖRÜ KARTI
                                MDCard:
                                    size_hint_y: None
                                    height: "90dp"
                                    padding: "15dp"
                                    radius: [16]
                                    elevation: 0
                                    md_bg_color: (0.1, 0.1, 0.1, 0.5) if app.theme_cls.theme_style == "Dark" else (0.9, 0.9, 0.9, 0.5)
                                    orientation: "horizontal"
                                    spacing: "15dp"

                                    MDIcon:
                                        id: prediction_icon
                                        icon: "robot-outline"
                                        theme_text_color: "Custom"
                                        text_color: 0.5, 0.5, 0.5, 1
                                        font_size: "36sp"
                                        pos_hint: {"center_y": .5}

                                    MDBoxLayout:
                                        orientation: "vertical"
                                        spacing: "2dp"
                                        pos_hint: {"center_y": .5}
                                        MDLabel:
                                            text: "Algoritmik Öngörü"
                                            font_style: "Subtitle2"
                                            bold: True
                                            theme_text_color: "Primary"
                                        MDLabel:
                                            id: prediction_text
                                            text: "Veriler analiz ediliyor..."
                                            font_style: "Caption"
                                            theme_text_color: "Secondary"



                                # YENİ: AYLIK BÜTÇE PLANI KARTI
                                MDCard:
                                    orientation: "vertical"
                                    padding: "16dp"
                                    spacing: "10dp"
                                    size_hint_y: None
                                    height: "240dp"
                                    elevation: 0
                                    radius: [16, 16, 16, 16]
                                    md_bg_color: [1, 1, 1, 1]
                                    line_color: [0.9, 0.9, 0.9, 1]
                                    line_width: 1.2

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: "30dp"
                                        spacing: "10dp"
                                        MDIcon:
                                            id: projection_icon
                                            icon: "calendar-month"
                                            theme_text_color: "Custom"
                                            text_color: app.theme_cls.primary_color
                                            font_size: "24sp"
                                        MDLabel:
                                            text: "Aylık Bütçe Planı"
                                            font_style: "H6"
                                            bold: True
                                        MDIconButton:
                                            icon: "pencil-outline"
                                            pos_hint: {"center_y": .5}
                                            on_release: app.show_budget_planner()

                                    # YENİ: Yatay Ay Seçici
                                    ScrollView:
                                        do_scroll_y: False
                                        do_scroll_x: True
                                        size_hint_y: None
                                        height: "40dp"
                                        
                                        MDBoxLayout:
                                            id: month_selector_container
                                            orientation: "horizontal"
                                            adaptive_width: True
                                            spacing: "10dp"
                                            
                                            # Dinamik Olarak Python Tarafından Doldurulacak

                                    MDLabel:
                                        id: projection_label
                                        text: "Ay seçin ve plan oluşturun..."
                                        theme_text_color: "Secondary"
                                        font_style: "Body2"
                                        halign: "left"
                                        valign: "top"
                                        text_size: self.width, None

                                # YENİ: AKTİF BORÇLARIM KARTI
                                MDCard:
                                    orientation: "vertical"
                                    padding: "16dp"
                                    spacing: "10dp"
                                    size_hint_y: None
                                    height: "260dp"
                                    elevation: 0
                                    radius: [16, 16, 16, 16]
                                    md_bg_color: [1, 1, 1, 1]
                                    line_color: [0.9, 0.9, 0.9, 1]
                                    line_width: 1.2

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: "30dp"
                                        spacing: "10dp"
                                        MDIcon:
                                            icon: "credit-card-clock-outline"
                                            theme_text_color: "Custom"
                                            text_color: app.theme_cls.primary_color
                                            font_size: "24sp"
                                        MDLabel:
                                            text: "Aktif Borçlarım"
                                            font_style: "H6"
                                            bold: True
                                            
                                    ScrollView:
                                        MDBoxLayout:
                                            id: active_debts_container
                                            orientation: "vertical"
                                            spacing: "10dp"
                                            adaptive_height: True
                                            
                                            MDLabel:
                                                text: "Henüz aktif bir borcunuz bulunmuyor."
                                                theme_text_color: "Secondary"
                                                font_style: "Body2"
                                                halign: "center"

                                # YENİ: YAKLAŞAN ÖDEMELER KARTI
                                MDCard:
                                    orientation: "vertical"
                                    padding: "16dp"
                                    spacing: "10dp"
                                    size_hint_y: None
                                    height: "220dp"
                                    elevation: 0
                                    radius: [16, 16, 16, 16]
                                    md_bg_color: [1, 1, 1, 1]
                                    line_color: [0.9, 0.9, 0.9, 1]
                                    line_width: 1.2

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: "30dp"
                                        spacing: "10dp"
                                        MDIcon:
                                            icon: "calendar-clock-outline"
                                            theme_text_color: "Custom"
                                            text_color: app.theme_cls.primary_color
                                            font_size: "24sp"
                                        MDLabel:
                                            text: "Yaklaşan Ödemeler"
                                            font_style: "H6"
                                            bold: True

                                    ScrollView:
                                        MDBoxLayout:
                                            id: upcoming_payments_container
                                            orientation: "vertical"
                                            spacing: "10dp"
                                            adaptive_height: True

                                            MDLabel:
                                                text: "Yaklaşan ödeme bulunmuyor."
                                                theme_text_color: "Secondary"
                                                font_style: "Body2"
                                                halign: "center"


                                # YENİ: SON İŞLEMLER LİSTESİ VE FİLTRESİ
                                MDBoxLayout:
                                    orientation: "vertical"
                                    size_hint_y: None
                                    height: self.minimum_height
                                    spacing: "10dp"
                                    padding: ["0dp", "15dp", "0dp", "0dp"]
                                    
                                    MDLabel:
                                        text: "Son İşlemler"
                                        font_style: "H6"
                                        bold: True
                                        size_hint_y: None
                                        height: "30dp"
                                        
                                    MDSegmentedControl:
                                        pos_hint: {"center_x": .5}
                                        size_hint_x: 1
                                        md_bg_color: (0.15, 0.15, 0.15, 1) if app.theme_cls.theme_style == "Dark" else (0.9, 0.9, 0.9, 1)
                                        segment_color: (0.3, 0.3, 0.3, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)
                                        on_active: app.load_recent_transactions(args[1].text)
                                        MDSegmentedControlItem:
                                            text: "Günlük"
                                        MDSegmentedControlItem:
                                            text: "Haftalık"
                                        MDSegmentedControlItem:
                                            text: "Aylık"
                                            
                                    RecycleView:
                                        id: recent_transactions_list
                                        viewclass: RecycleListRow
                                        size_hint_y: None
                                        height: "400dp"

                                        RecycleBoxLayout:
                                            id: recent_tx_rv_box
                                            orientation: "vertical"
                                            default_size: None, dp(73)
                                            default_size_hint: 1, None
                                            size_hint_y: None
                                            height: self.minimum_height

                # ==== 2. SEKME: VARLIKLARIM ====
                MDBottomNavigationItem:
                    name: "assets_tab"
                    text: "Varlıklarım"
                    icon: "finance"
                    on_tab_press:
                        chart_master_box.refresh_dashboard(app.home_filter)
                        app.load_recent_transactions()
                    
                    MDFloatLayout:
                        MDBoxLayout:
                            orientation: "vertical"
                            MDTopAppBar:
                                title: "Varlıklarım"
                                elevation: 4
                            
                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "top"
                                
                                ScrollView:
                                    size_hint_x: 1
                                    
                                    MDBoxLayout:
                                        orientation: "vertical"
                                        adaptive_height: True
                                        padding: "24dp"
                                        spacing: "24dp"

                                        # --- DÖNEM ÖZET KARTI (3 metrik: Gelir | Gider | Net) ---
                                        MDBoxLayout:
                                            orientation: "horizontal"
                                            size_hint_y: None
                                            height: "96dp"
                                            spacing: "10dp"

                                            # Gelir kartı
                                            MDCard:
                                                orientation: "vertical"
                                                padding: ["12dp", "10dp", "12dp", "10dp"]
                                                radius: [14, 14, 14, 14]
                                                elevation: 0

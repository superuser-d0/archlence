                                                    md_bg_color: 0.9, 0.9, 0.9, 1
                                                    text_color: 0.5, 0.5, 0.5, 1
                                                    on_release: app.change_home_filter("Hayat Boyu")
                                            
                                            MDBoxLayout:
                                                orientation: "vertical"
                                                spacing: "15dp"
                                                adaptive_height: True

                                                DashboardChartManager:
                                                    id: chart_master_box
                                                    orientation: "horizontal"
                                                    size_hint_x: 1
                                                    size_hint_y: None
                                                    height: "320dp"
                                                    padding: dp(8)
                                                    spacing: dp(10)

                                                    MDBoxLayout:
                                                        id: pie_chart_box
                                                        orientation: "vertical"
                                                        size_hint_x: 0.35
                                                        size_hint_y: 1
                                                        spacing: dp(4)

                                                    MDBoxLayout:
                                                        id: comparison_chart_box
                                                        orientation: "vertical"
                                                        size_hint_x: 0.65
                                                        size_hint_y: 1

                                                # --- TOPLAM VARLIK KARTI ---
                                                MDCard:
                                                    id: total_wealth_card

#:import FadeTransition kivy.uix.screenmanager.FadeTransition
#:import Window kivy.core.window.Window
#:import dp kivy.metrics.dp
#:import RecycleListRow ui.components.RecycleListRow
#:import SubscriptionRow ui.components.SubscriptionRow
#:import ftheme ui.theme
#:import TextInput kivy.uix.textinput.TextInput
#:import SearchBar ui.components.SearchBar
#:import PassthroughScrollView ui.components.PassthroughScrollView
#:import PassthroughRecycleView ui.components.PassthroughRecycleView

# --- 0. GLOBAL WIDGET KURALLARI ---
# Tüm giriş alanları: karanlık temada hint/helper metinleri KivyMD varsayılanıyla
# siyaha yakın kalıp okunmuyordu. Kural sınıf düzeyinde olduğu için Python'da
# imperatif kurulan diyalog alanlarına da uygulanır ve tema değişiminde canlı
# güncellenir.
<MDTextField>:
    hint_text_color_normal: ftheme.field_color(app.theme_cls.theme_style, 'hint')
    hint_text_color_focus: ftheme.field_color(app.theme_cls.theme_style, 'hint')
    helper_text_color_normal: ftheme.field_color(app.theme_cls.theme_style, 'hint')
    helper_text_color_focus: ftheme.field_color(app.theme_cls.theme_style, 'hint')
    text_color_normal: ftheme.field_color(app.theme_cls.theme_style, 'text')
    text_color_focus: ftheme.field_color(app.theme_cls.theme_style, 'text')
    fill_color_normal: ftheme.field_color(app.theme_cls.theme_style, 'fill')
    fill_color_focus: ftheme.field_color(app.theme_cls.theme_style, 'fill')
    line_color_normal: ftheme.field_color(app.theme_cls.theme_style, 'line')

<SearchBar>:
    # KivyMD 1.2 "round" zemini iki yarım Ellipse + kısa Rectangle ile
    # kuruyor. Sağ yarım elipsin çapı rectangle tarafından örtülmediği için
    # tam ortasında kesintisiz dikey bir birleşim çizgisi kalıyor. Tek bir
    # RoundedRectangle ile aynı yüzeyi yeniden kurmak geometriyi gerçekten
    # birleştirir; DPI/piksel ofseti veya zemin rengiyle örtme değildir.
    orientation: "horizontal"
    padding: ["12dp", 0, "12dp", 0]
    spacing: "8dp"
    canvas.before:
        Color:
            rgba: ftheme.field_color(app.theme_cls.theme_style, 'fill')
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]
        Color:
            rgba: app.theme_cls.primary_color if self.focused else ftheme.field_color(app.theme_cls.theme_style, 'line')
        SmoothLine:
            width: dp(1)
            rounded_rectangle: self.x, self.y, self.width, self.height, self.height / 2

<MDBottomNavigationBar>:
    elevation: 0
    shadow_softness: 0

# --- 1. ÖZEL LİSTE ELEMANLARI VE KURALLAR ---
<LegendItem>:
    orientation: "horizontal"
    size_hint_y: None
    height: "26dp"

<CategorySettingItem>:
    orientation: "horizontal"
    size_hint_y: None
    height: "56dp"
    padding: ["15dp", 0, "40dp", 0]
    spacing: "10dp"
    
    MDLabel:
        text: root.cat_name
        theme_text_color: "Primary"
    MDSwitch:
        size_hint_x: None
        width: "52dp"
        pos_hint: {"center_y": .5}
        icon_active: "check"
        icon_inactive: "close"
        active: True if root.cat_importance == 'main' else False
        on_active: app.update_category_importance(root.cat_name, self.active)

<ClickableSettingsRow@ButtonBehavior+MDBoxLayout>:

<BudgetListItem>:
    text: app.tr("", app.language)
    secondary_text: ""
    
    IconLeftWidget:
        icon: "cash-plus" if "Gelir" in root.secondary_text else "cash-minus"
        theme_text_color: "Custom"
        text_color: ftheme.accent(app.theme_cls.theme_style, 'green' if "Gelir" in root.secondary_text else 'red')

# "Aktif Aboneliklerim" / "Aktif Gelirlerim" RecycleView satırı.
# Görsel olarak eski imperatif MDCard'ın birebir aynısı; farkı satırların
# geri dönüştürülmesi (bkz. ui/components.py::SubscriptionRow).
<SubscriptionRow>:
    orientation: "vertical"
    padding: "12dp"
    spacing: "5dp"
    size_hint_y: None
    height: "92dp"
    radius: [16]
    elevation: 0
    # Python'daki ftheme.apply_card_theme(tint="green") ile aynı sonuç;
    # KV bağlaması sayesinde tema değişiminde kendiliğinden tazelenir
    # (imperatif kartlar refresh_card_theme taramasına muhtaçtı).
    line_color: ftheme.card_line(app.theme_cls.theme_style)
    md_bg_color: ftheme.tint_bg(app.theme_cls.theme_style, "green")

    MDBoxLayout:
        orientation: "horizontal"
        spacing: "10dp"
        size_hint_y: None
        height: "32dp"

        # Logo mu vektör ikon mu olacağı satır geri dönüştürülürken
        # değişebildiği için bu slot imperatif doldurulur.
        MDBoxLayout:
            id: icon_slot
            size_hint: None, None
            size: dp(32), dp(32)
            pos_hint: {"center_y": .5}

        MDLabel:
            text: root.name
            font_style: "Subtitle2"
            bold: True
            pos_hint: {"center_y": .5}

        MDLabel:
            text: root.amount_text
            font_style: "Caption"
            theme_text_color: "Secondary"
            halign: "right"
            size_hint_x: None
            width: "90dp"

    MDBoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: "34dp"

        MDLabel:
            text: root.renewal_text
            font_style: "Caption"
            theme_text_color: "Secondary"

        MDFlatButton:
            text: app.tr("DÜZENLE", app.language)
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color
            on_release: app.open_subscription_price_dialog(root.payment)

        MDFlatButton:
            text: app.tr("KALDIR", app.language)
            theme_text_color: "Custom"
            text_color: ftheme.accent(app.theme_cls.theme_style, 'muted')
            on_release: app.open_subscription_cancel_dialog(root.payment)

# --- 2. ANA ARAYÜZ İSKELETİ ---
MDScreen:
    md_bg_color: app.theme_cls.bg_normal

    MDScreenManager:
        id: screen_manager
        transition: FadeTransition(duration=0.2)

        # --- İLK AÇILIŞ: YEREL ŞİFRE OLUŞTURMA ---
        MDScreen:
            name: "pin_setup"
            MDFloatLayout:
                MDIconButton:
                    icon: "cog"
                    pos_hint: {"top": 0.98, "right": 0.98}
                    theme_text_color: "Hint"
                    on_release: screen_manager.current = "pre_login_settings"

                MDBoxLayout:
                    orientation: "vertical"
                    padding: "40dp"
                    spacing: "18dp"
                    pos_hint: {"center_x": .5, "center_y": .5}
                    size_hint_y: None
                    height: "460dp"

                    MDLabel:
                        text: app.tr("ARCHLENCE", app.language)
                        font_style: "H3"
                        halign: "center"
                        theme_text_color: "Primary"
                        bold: True

                    MDLabel:
                        text: app.tr("Yerel Şifreni Belirle", app.language)
                        font_style: "Subtitle1"
                        halign: "center"
                        theme_text_color: "Secondary"

                    MDTextField:
                        id: pin_setup_input
                        hint_text: app.tr("Şifre", app.language)
                        password: True
                        max_text_length: 32
                        size_hint_x: 0.8
                        pos_hint: {"center_x": .5}
                        multiline: False
                        write_tab: False
                        focus_next: pin_confirm_input
                        on_text_validate: pin_confirm_input.focus = True
                        helper_text: app.tr("En az 4 karakter, 1 büyük harf ve 1 özel karakter", app.language)
                        helper_text_mode: "persistent"

                    MDTextField:
                        id: pin_confirm_input
                        hint_text: app.tr("Şifre Tekrar", app.language)
                        password: True
                        max_text_length: 32
                        size_hint_x: 0.8
                        pos_hint: {"center_x": .5}
                        multiline: False
                        write_tab: False
                        # Son alan: TAB döngüsü başa dönsün, odak kaybolmasın.
                        focus_next: pin_setup_input
                        focus_previous: pin_setup_input
                        on_text_validate: app.setup_pin()

                    MDLabel:
                        id: pin_setup_error_label
                        text: app.tr("", app.language)
                        theme_text_color: "Error"
                        halign: "center"
                        size_hint_y: None
                        height: "28dp"

                    MDRaisedButton:
                        text: app.tr("ŞİFRE OLUŞTUR", app.language)
                        size_hint_x: 0.5
                        pos_hint: {"center_x": .5}
                        on_release: app.setup_pin()

                    MDLabel:
                        text: app.tr("Şifre yalnızca bu cihazda saklanır; Archlence verilerinizi bir sunucuya göndermez.", app.language)
                        font_style: "Caption"
                        theme_text_color: "Hint"
                        halign: "center"
                        size_hint_x: 0.8
                        pos_hint: {"center_x": .5}
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]

        # --- İLK AÇILIŞ: ZORUNLU İLK HESAP OLUŞTURMA ---
        # Varsayılan hesap seed'i kaldırıldığı için taze kurulumda hiç hesap
        # yoktur. İşlem yazan her akış bir hesap id'si gerektirdiğinden, hesap
        # oluşturulmadan dashboard'a geçilmesine izin verilmez (bkz.
        # app.route_after_auth / app.create_first_account).
        MDScreen:
            name: "account_setup"
            MDFloatLayout:
                MDBoxLayout:
                    orientation: "vertical"
                    padding: "40dp"
                    spacing: "18dp"
                    pos_hint: {"center_x": .5, "center_y": .5}
                    size_hint_y: None
                    height: "420dp"

                    MDLabel:
                        text: app.tr("İlk Hesabını Oluştur", app.language)
                        font_style: "H5"
                        halign: "center"
                        theme_text_color: "Primary"
                        bold: True

                    MDLabel:
                        text: app.tr("Gelir ve giderlerin bir hesaba işlenmesi gerekir. Dilediğin zaman Kartlarım sekmesinden yeni hesap veya kart ekleyebilirsin.", app.language)
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        halign: "center"
                        size_hint_x: 0.85
                        pos_hint: {"center_x": .5}
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDTextField:
                        id: first_account_name_input
                        hint_text: app.tr("Hesap Adı (Örn: Nakit Cüzdanım)", app.language)
                        text: app.tr("Nakit Cüzdanım", app.language)
                        size_hint_x: 0.8
                        pos_hint: {"center_x": .5}
                        multiline: False
                        write_tab: False
                        focus_next: first_account_balance_input
                        on_text_validate: first_account_balance_input.focus = True

                    MDTextField:
                        id: first_account_balance_input
                        hint_text: app.tr("Başlangıç Bakiyesi (₺)", app.language)
                        text: "0"
                        input_filter: "float"
                        size_hint_x: 0.8
                        pos_hint: {"center_x": .5}
                        multiline: False
                        write_tab: False
                        focus_next: first_account_name_input
                        focus_previous: first_account_name_input
                        on_text_validate: app.create_first_account()

                    MDLabel:
                        id: first_account_error_label
                        text: ""
                        theme_text_color: "Error"
                        halign: "center"
                        size_hint_y: None
                        height: "28dp"

                    MDRaisedButton:
                        text: app.tr("HESABI OLUŞTUR", app.language)
                        size_hint_x: 0.6
                        pos_hint: {"center_x": .5}
                        on_release: app.create_first_account()

        # --- GİRİŞ EKRANI ---
        MDScreen:
            name: "login"
            MDFloatLayout:
                MDIconButton:
                    icon: "cog"
                    pos_hint: {"top": 0.98, "right": 0.98}
                    theme_text_color: "Hint"
                    on_release: screen_manager.current = "pre_login_settings"

                MDBoxLayout:
                    orientation: "vertical"
                    padding: "40dp"
                    spacing: "20dp"
                    pos_hint: {"center_x": .5, "center_y": .5}
                    size_hint_y: None
                    height: "420dp"

                    MDLabel:
                        text: app.tr("ARCHLENCE", app.language)
                        font_style: "H3"
                        halign: "center"
                        theme_text_color: "Primary"
                        bold: True

                    MDLabel:
                        text: app.tr("Güvenli Giriş", app.language)
                        font_style: "Subtitle1"
                        halign: "center"
                        theme_text_color: "Secondary"

                    MDRelativeLayout:
                        id: password_container
                        size_hint_x: 0.8
                        pos_hint: {"center_x": .5}
                        size_hint_y: None
                        height: password_input.height

                        MDTextField:
                            id: password_input
                            hint_text: app.tr("Şifre", app.language)
                            password: True
                            max_text_length: 32
                            multiline: False
                            write_tab: False
                            on_text_validate: app.check_login()

                        MDIconButton:
                            icon: "eye-off"
                            pos_hint: {"center_y": .5}
                            pos: password_input.width - self.width, 0
                            theme_text_color: "Hint"
                            on_release:
                                self.icon = "eye" if self.icon == "eye-off" else "eye-off"
                                password_input.password = False if password_input.password is True else True

                    MDLabel:
                        id: login_error_label
                        text: app.tr("", app.language)
                        theme_text_color: "Error"
                        halign: "center"
                        size_hint_y: None
                        height: "20dp"

                    MDRaisedButton:
                        text: app.tr("GİRİŞ YAP", app.language)
                        size_hint_x: 0.5
                        pos_hint: {"center_x": .5}
                        on_release: app.check_login()

                    MDLabel:
                        text: app.tr("Şifreni mi unuttun? Sağ üstteki Ayarlar > Şifre ve Verileri Sıfırla yolunu kullanabilirsin. Tüm yerel finans verilerin silinir.", app.language)
                        halign: "center"
                        font_style: "Caption"
                        theme_text_color: "Hint"
                        size_hint_x: 0.8
                        pos_hint: {"center_x": .5}
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]

        # --- GİRİŞ ÖNCESİ AYARLAR EKRANI ---
        MDScreen:
            name: "pre_login_settings"
            MDBoxLayout:
                orientation: "vertical"
                MDTopAppBar:
                    title: app.tr("Ayarlar", app.language)
                    left_action_items: [["arrow-left", lambda x: setattr(screen_manager, 'current', app.authentication_screen())]]
                    elevation: 4
                
                ScrollView:
                    MDBoxLayout:
                        orientation: "vertical"
                        adaptive_height: True
                        MDSeparator:

                        ClickableSettingsRow:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: "64dp"
                            padding: ["20dp", 0, "20dp", 0]
                            spacing: "20dp"
                            on_release: app.open_language_dialog()
                            MDIcon:
                                icon: "translate"
                                size_hint_x: None
                                width: "36dp"
                                halign: "center"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Primary"
                            MDBoxLayout:
                                orientation: "vertical"
                                MDLabel:
                                    text: app.tr("Dil", app.language)
                                    theme_text_color: "Primary"
                                MDLabel:
                                    text: "English" if app.language == "en" else "Türkçe"
                                    font_style: "Caption"
                                    theme_text_color: "Secondary"
                            MDIcon:
                                icon: "chevron-right"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Hint"

                        MDSeparator:

                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: "64dp"
                            padding: ["20dp", 0, "20dp", 0]
                            spacing: "20dp"
                            MDIcon:
                                icon: "moon-waning-crescent"
                                size_hint_x: None
                                width: "36dp"
                                halign: "center"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Primary"
                            MDLabel:
                                text: app.tr("Karanlık Mod", app.language)
                                theme_text_color: "Primary"
                            MDSwitch:
                                size_hint_x: None
                                width: "52dp"
                                pos_hint: {"center_y": .5}
                                icon_active: "check"
                                icon_inactive: "close"
                                active: True if app.theme_cls.theme_style == "Dark" else False
                                on_active: app.toggle_theme(self.active)
                        MDSeparator:

                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: "64dp"
                            padding: ["20dp", 0, "20dp", 0]
                            spacing: "20dp"
                            MDIcon:
                                icon: "palette-outline"
                                size_hint_x: None
                                width: "36dp"
                                halign: "center"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Primary"
                            MDBoxLayout:
                                orientation: "vertical"
                                MDLabel:
                                    text: app.tr("Premium Mavi Tema", app.language)
                                    theme_text_color: "Primary"
                                MDLabel:
                                    text: app.tr("Kapalıyken standart tema kullanılır", app.language)
                                    font_style: "Caption"
                                    theme_text_color: "Secondary"
                            MDSwitch:
                                size_hint_x: None
                                width: "52dp"
                                pos_hint: {"center_y": .5}
                                icon_active: "check"
                                icon_inactive: "close"
                                active: app.theme_name == "premium"
                                on_active: app.apply_theme("premium" if self.active else "standard")
                        MDSeparator:

                        ClickableSettingsRow:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: "72dp"
                            padding: ["20dp", 0, "20dp", 0]
                            spacing: "20dp"
                            on_release: app.confirm_delete_all_data()
                            MDIcon:
                                icon: "delete-forever"
                                size_hint_x: None
                                width: "36dp"
                                halign: "center"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Error"
                            MDBoxLayout:
                                orientation: "vertical"
                                MDLabel:
                                    text: app.tr("Şifre ve Verileri Sıfırla", app.language)
                                    theme_text_color: "Error"
                                MDLabel:
                                    text: app.tr("Şifre dahil tüm yerel finans verilerini kalıcı olarak siler", app.language)
                                    font_style: "Caption"
                                    theme_text_color: "Secondary"
                            MDIcon:
                                icon: "chevron-right"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Hint"

                        MDSeparator:
                Widget:

        # --- ANA UYGULAMA (SABİT ALT SEKMELER - BOTTOM NAVIGATION) ---
        MDScreen:
            name: "home"

            MDBottomNavigation:
                id: bottom_nav
                transition_duration: 0.4
                # Aktif sekme: %12 opaklıkta indigo vurgu kartı (Premium Banking)
                selected_color_background: app.theme_cls.primary_color[:3] + [0.12]
                text_color_active: app.theme_cls.primary_color
                # Navigasyon paneli açık temada saf beyaz yüzey
                panel_color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Light" else app.theme_cls.bg_normal

                # ==== 1. SEKME: ANA SAYFA ====
                MDBottomNavigationItem:
                    name: "home_tab"
                    text: app.tr("Ana Sayfa", app.language)
                    icon: "home-variant"
                    
                    MDBoxLayout:
                        orientation: "vertical"
                        
                        MDBoxLayout:
                            size_hint_y: None
                            height: "72dp"
                            padding: ["16dp", "10dp", "16dp", "10dp"]
                            spacing: "15dp"
                            
                            MDIconButton:
                                icon: "account-circle"
                                icon_size: "36dp"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Primary"
                                on_release: bottom_nav.switch_tab("settings_tab")
                                
                            SearchBar:
                                size_hint_y: None
                                height: "40dp"
                                pos_hint: {"center_y": .5}
                                MDIconButton:
                                    # `MDIcon` DEĞİL. Eskiden öyleydi ve
                                    # kullanıcının "arama butonu hiçbir şekilde
                                    # çalışmıyor" demesinin sebebi tam olarak
                                    # buydu: `MDIcon` `ButtonBehavior`
                                    # miraslamaz, yani tıklamayı hiç almaz.
                                    # Artık en azından alanı odaklıyor.
                                    icon: "magnify"
                                    icon_size: "20dp"
                                    size_hint: None, None
                                    # 40dp'lik çubuğa sığması için açık ölçü;
                                    # MDIconButton varsayılanı 48dp ve çubuğu
                                    # dikeyde taşırıyordu.
                                    size: "32dp", "32dp"
                                    pos_hint: {"center_y": .5}
                                    theme_text_color: "Hint"
                                    on_release: app.focus_home_search()
                                TextInput:
                                    id: home_search_input
                                    hint_text: app.tr("Hesap, kategori veya işlem ara...", app.language)
                                    multiline: False
                                    write_tab: False
                                    background_normal: ""
                                    background_active: ""
                                    background_color: 0, 0, 0, 0
                                    foreground_color: ftheme.field_color(app.theme_cls.theme_style, 'text')
                                    hint_text_color: ftheme.field_color(app.theme_cls.theme_style, 'hint')
                                    cursor_color: app.theme_cls.primary_color
                                    cursor_width: "1dp"
                                    padding: [0, "9dp", 0, "9dp"]
                                    on_focus: self.parent.focused = self.focus
                                    on_text: app.on_home_search_text(self, self.text)

                            MDIconButton:
                                # Artık bir işleyicisi VAR. Bir tur boyunca
                                # yoktu ve dokununca dalga animasyonu oynayıp
                                # hiçbir şey yapmıyordu — arama çubuğuyla aynı
                                # kusur sınıfı.
                                icon: "bell-outline"
                                icon_size: "28dp"
                                pos_hint: {"center_y": .5}
                                theme_text_color: "Primary"
                                on_release: app.toggle_notifications()

                        # BİLDİRİM PANELİ — arama sonuçlarıyla aynı desen:
                        # modal değil, satır içi, boşken sıfır yükseklik.
                        # İkisi aynı anda açılmıyor (bkz. toggle_notifications).
                        MDBoxLayout:
                            id: home_notifications
                            orientation: "vertical"
                            size_hint_y: None
                            height: 0
                            padding: ["16dp", 0, "16dp", 0]

                        # ARAMA SONUÇLARI — modal değil, satır içi.
                        # `MDDropdownMenu` KivyMD 1.2'de `ModalView` üzerine
                        # kuruluyor ve açılınca odağı yakalıyor; her tuş
                        # vuruşunda yeniden açmak kullanıcının ikinci
                        # karakteri yazamaması demekti. Normal bir kutu
                        # olduğu için odak `TextInput`'ta kalıyor.
                        #
                        # Yükseklik 0'dan başlıyor ve içeriği mixin
                        # dolduruyor; sonuç yokken sıfır yer kaplıyor —
                        # bu turda boş kartlarda düzeltilen kusurun aynısına
                        # düşmemek için.
                        MDBoxLayout:
                            id: home_search_results
                            orientation: "vertical"
                            size_hint_y: None
                            height: 0
                            padding: ["16dp", 0, "16dp", 0]

                        ScrollView:
                            # Bu ekran programatik bir kaydırma göstergesine
                            # ihtiyaç duymuyor. Kivy'nin varsayılan 2px bar'ı
                            # pencerenin en sağında bağımsız dikey çizgi gibi
                            # görünüyordu.
                            bar_width: 0
                            MDBoxLayout:
                                orientation: "vertical"
                                padding: ["20dp", "10dp", "20dp", "20dp"]
                                spacing: "20dp"
                                size_hint_y: None
                                height: self.minimum_height

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "40dp"
                                    pos_hint: {"center_x": .5}
                                    adaptive_width: True
                                    spacing: "8dp"
                                    
                                    MDIcon:
                                        id: wallet_icon
                                        icon: "wallet"
                                        size_hint_x: None
                                        width: "28dp"
                                        theme_text_color: "Secondary"
                                        pos_hint: {"center_y": .5}
                                    MDLabel:
                                        text: app.tr("Cüzdanım", app.language)
                                        font_style: "Subtitle1"
                                        bold: True
                                        adaptive_width: True
                                        pos_hint: {"center_y": .5}
                                    MDIcon:
                                        icon: "chevron-down"
                                        size_hint_x: None
                                        width: "28dp"
                                        theme_text_color: "Secondary"
                                        pos_hint: {"center_y": .5}

                                MDRelativeLayout:
                                    size_hint: None, None
                                    size: "240dp", "240dp"
                                    pos_hint: {"center_x": .5}

                                    MDFloatLayout:
                                        id: balance_circle
                                        canvas.before:
                                            Color:
                                                rgba: app.home_circle_color
                                            Line:
                                                width: 2.5
                                                circle: (self.center_x, self.center_y, dp(115))

                                    MDBoxLayout:
                                        orientation: "vertical"
                                        size_hint: None, None
                                        size: "220dp", "150dp"
                                        pos_hint: {"center_x": .5, "center_y": .5}
                                        spacing: "10dp"

                                        MDLabel:
                                            text: app.tr("Toplam Bakiye", app.language)
                                            halign: "center"
                                            theme_text_color: "Secondary"

                                        MDLabel:
                                            id: home_total_balance
                                            text: app.tr("0,00 ₺", app.language)
                                            font_style: "H5"
                                            bold: True
                                            halign: "center"
                                            theme_text_color: "Primary"

                                        MDBoxLayout:
                                            orientation: "horizontal"
                                            adaptive_size: True
                                            pos_hint: {"center_x": .5}
                                            spacing: "10dp"
                                            
                                            MDLabel:
                                                id: change_rate_label
                                                text: app.tr("%0.0", app.language)
                                                font_size: "14sp"
                                                theme_text_color: "Custom"
                                                text_color: ftheme.accent(app.theme_cls.theme_style, 'blue')
                                                adaptive_width: True
                                            MDIcon:
                                                icon: "chart-line-variant"
                                                theme_text_color: "Custom"
                                                text_color: ftheme.accent(app.theme_cls.theme_style, 'blue')
                                                font_size: "16sp"
                                                size_hint_x: None
                                                width: "20dp"
                                                pos_hint: {"center_y": .5}
                                                
                                        MDLabel:
                                            id: home_change_title
                                            text: app.tr("Aylık Gider Değişimi", app.language)
                                            halign: "center"
                                            font_size: "12sp"
                                            theme_text_color: "Secondary"

                                # NEGATİF BAKİYE UYARISI: toplam nakit bakiye 0'ın altına
                                # düştüğünde görünür olur, artıya dönünce tekrar gizlenir
                                # (bkz. main.py update_metrics_and_goals).
                                MDBoxLayout:
                                    id: negative_balance_warning
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: 0
                                    opacity: 0
                                    spacing: "6dp"
                                    pos_hint: {"center_x": .5}

                                    MDIcon:
                                        icon: "alert-circle"
                                        theme_text_color: "Error"
                                        font_size: "16sp"
                                        size_hint_x: None
                                        width: "20dp"
                                        pos_hint: {"center_y": .5}
                                    MDLabel:
                                        id: negative_balance_label
                                        text: app.tr("Dikkat: Bakiye Negatif!", app.language)
                                        theme_text_color: "Error"
                                        font_style: "Caption"
                                        bold: True
                                        adaptive_width: True
                                        pos_hint: {"center_y": .5}

                                # ZAMAN FİLTRESİ
                                MDSegmentedControl:
                                    id: home_period_control
                                    pos_hint: {"center_x": .5}
                                    size_hint_x: 0.9
                                    md_bg_color: ftheme.muted_bg(app.theme_cls.theme_style)
                                    segment_color: ftheme.card_bg(app.theme_cls.theme_style)
                                    on_active: app.change_home_filter(args[1].text)
                                    MDSegmentedControlItem:
                                        id: segment_filter_today
                                        text: app.tr("Bugün", app.language)
                                    MDSegmentedControlItem:
                                        id: segment_filter_week
                                        text: app.tr("1 Hafta", app.language)
                                    MDSegmentedControlItem:
                                        id: segment_filter_month
                                        text: app.tr("1 Ay", app.language)
                                    MDSegmentedControlItem:
                                        id: segment_filter_year
                                        text: app.tr("1 Yıl", app.language)

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_y: None
                                    height: "100dp"
                                    spacing: "15dp"

                                    MDCard:
                                        elevation: 0
                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                        padding: "15dp"
                                        radius: [24]
                                        md_bg_color: ftheme.muted_bg(app.theme_cls.theme_style)
                                        orientation: "vertical"
                                        
                                        MDLabel:
                                            id: today_card_title
                                            text: app.tr("Bugün", app.language)
                                            font_size: "14sp"
                                            theme_text_color: "Secondary"
                                        MDLabel:
                                            id: today_card_amount
                                            text: app.tr("0,0 ₺", app.language)
                                            font_style: "Subtitle1"
                                            bold: True

                                    MDCard:
                                        elevation: 0
                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                        padding: "15dp"
                                        radius: [24]
                                        md_bg_color: ftheme.muted_bg(app.theme_cls.theme_style)
                                        orientation: "vertical"
                                        
                                        MDLabel:
                                            text: app.tr("Toplam", app.language)
                                            font_size: "14sp"
                                            theme_text_color: "Secondary"
                                        MDLabel:
                                            id: total_card_amount
                                            text: app.tr("0,0 ₺", app.language)
                                            font_style: "Subtitle1"
                                            bold: True

                                # YENİ: MATEMATİKSEL ÖNGÖRÜ KARTI
                                # DÜZELTME (2026-07-29): kart sabit "90dp" idi — bu, prediction_text
                                # tek satırlık bir metinken yeterliydi. Metin artık 3 aylık öngörü
                                # paragrafıyla birlikte 4-5 satıra çıkabiliyor (bkz.
                                # main.py::_compute_monthly_forecast_text); prediction_text'in
                                # `size_hint_y`/`text_size` bağlanmamış olması, taşan metnin kendi
                                # kutusunun DIŞINA, üstündeki başlık etiketiyle ÇAKIŞACAK şekilde
                                # çizilmesine yol açıyordu ("Şurası da kaymış" ekran görüntüsü).
                                # Artık kart + iç kutu + etiket üçü de içeriğe göre büyüyor.
                                MDCard:
                                    elevation: 0
                                    line_color: ftheme.card_line(app.theme_cls.theme_style)
                                    size_hint_y: None
                                    height: max(dp(90), self.minimum_height + dp(30))
                                    padding: "15dp"
                                    radius: [24]
                                    md_bg_color: ftheme.muted_bg(app.theme_cls.theme_style)
                                    orientation: "horizontal"
                                    spacing: "15dp"

                                    MDIcon:
                                        id: prediction_icon
                                        icon: "robot-outline"
                                        theme_text_color: "Custom"
                                        text_color: ftheme.accent(app.theme_cls.theme_style, 'muted')
                                        font_size: "36sp"
                                        # Genişlik AÇIKÇA veriliyor: genişliksiz
                                        # bırakılan MDIcon'un glifi yanındaki
                                        # metnin üstüne taşıyor (kart başlıklarında
                                        # düzeltilen kusurun aynısı). 36sp'lik glif
                                        # için 44dp ölçüldü.
                                        size_hint_x: None
                                        width: "44dp"
                                        size_hint_y: None
                                        height: self.texture_size[1]
                                        pos_hint: {"top": 1}

                                    MDBoxLayout:
                                        orientation: "vertical"
                                        spacing: "2dp"
                                        size_hint_y: None
                                        height: self.minimum_height
                                        pos_hint: {"top": 1}
                                        MDLabel:
                                            text: app.tr("Algoritmik Öngörü", app.language)
                                            font_style: "Subtitle2"
                                            bold: True
                                            theme_text_color: "Primary"
                                            size_hint_y: None
                                            height: self.texture_size[1]
                                        MDLabel:
                                            id: prediction_text
                                            text: app.tr("Veriler analiz ediliyor...", app.language)
                                            font_style: "Caption"
                                            theme_text_color: "Secondary"
                                            size_hint_y: None
                                            height: self.texture_size[1]
                                            text_size: self.width, None

                                # FAZ 1: FİNANSAL SAĞLIK SKORU KARTI
                                # Skor rengi/etiketi InsightsMixin.render_health_score
                                # tarafından ftheme.accent ile atanır; burada yalnızca
                                # yerleşim ve tema-duyarlı zemin var.
                                MDCard:
                                    elevation: 0
                                    line_color: ftheme.card_line(app.theme_cls.theme_style)
                                    size_hint_y: None
                                    height: "150dp"
                                    padding: "16dp"
                                    spacing: "10dp"
                                    radius: [24]
                                    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)
                                    orientation: "vertical"

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: "30dp"
                                        spacing: "10dp"
                                        MDIcon:
                                            icon: "heart-pulse"
                                            theme_text_color: "Custom"
                                            text_color: app.theme_cls.primary_color
                                            size_hint_x: None
                                            width: "24dp"
                                        MDLabel:
                                            text: app.tr("Finansal Sağlık Skoru", app.language)
                                            font_style: "Subtitle1"
                                            bold: True
                                            theme_text_color: "Primary"

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: "44dp"
                                        spacing: "12dp"
                                        MDLabel:
                                            id: health_score_value
                                            text: app.tr("--", app.language)
                                            font_style: "H4"
                                            bold: True
                                            size_hint_x: None
                                            width: "88dp"
                                            halign: "left"
                                            theme_text_color: "Custom"
                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'muted')
                                        MDLabel:
                                            id: health_score_label
                                            text: app.tr("Hesaplanıyor...", app.language)
                                            font_style: "Subtitle2"
                                            bold: True
                                            theme_text_color: "Secondary"
                                            pos_hint: {"center_y": .5}

                                    MDProgressBar:
                                        id: health_score_bar
                                        value: 0
                                        max: 100
                                        size_hint_y: None
                                        height: "6dp"
                                        color: app.theme_cls.primary_color

                                    MDLabel:
                                        id: health_breakdown_text
                                        text: app.tr("Tasarruf oranı, borç/gelir ve gider oynaklığı birlikte değerlendirilir.", app.language)
                                        font_style: "Caption"
                                        theme_text_color: "Secondary"

                                # FAZ 1: ABONELİK RADARI ("sessiz sızıntı")
                                MDCard:
                                    id: active_subscriptions_card
                                    elevation: 0
                                    line_color: ftheme.card_line(app.theme_cls.theme_style)
                                    orientation: "vertical"
                                    padding: "16dp"
                                    spacing: "10dp"
                                    size_hint_y: None
                                    adaptive_height: True
                                    radius: [24]
                                    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: "30dp"
                                        spacing: "10dp"
                                        MDIcon:
                                            icon: "radar"
                                            theme_text_color: "Custom"
                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'amber')
                                            size_hint_x: None
                                            width: "24dp"
                                        MDLabel:
                                            text: app.tr("Aktif Aboneliklerim", app.language)
                                            font_style: "Subtitle1"
                                            bold: True
                                            theme_text_color: "Primary"

                                    # Aktif abonelikler: satırlar geri dönüştürülür.
                                    # YÜKSEKLİK: az abonelikte içeriğe uyar (boş
                                    # alan bırakmaz), çoğaldığında 400dp'de
                                    # sabitlenir ve içeride kayar — sanallaştırma
                                    # ancak sınırlı bir görüntü alanında çalışır,
                                    # sayfa boyunca uzayan bir liste her satırı
                                    # yine de oluştururdu.
                                    PassthroughRecycleView:
                                        id: active_subscriptions_rv
                                        viewclass: "SubscriptionRow"
                                        size_hint_y: None
                                        height: min(sub_rv_box.minimum_height, dp(400))

                                        RecycleBoxLayout:
                                            id: sub_rv_box
                                            orientation: "vertical"
                                            default_size: None, dp(92)
                                            default_size_hint: 1, None
                                            size_hint_y: None
                                            height: self.minimum_height
                                            spacing: "10dp"

                                    # Radar adayları + boş/özet etiketleri
                                    # (sayı tespit mantığıyla sınırlı, sanallaştırma
                                    # gerektirecek kadar büyümüyor).
                                    MDBoxLayout:
                                        id: recurring_candidates_container
                                        orientation: "vertical"
                                        adaptive_height: True
                                        spacing: "10dp"

                                # YENİ: AKTİF GELİRLERİM KARTI
                                MDCard:
                                    id: active_incomes_card
                                    elevation: 0
                                    line_color: ftheme.card_line(app.theme_cls.theme_style)
                                    orientation: "vertical"
                                    padding: "16dp"
                                    spacing: "10dp"
                                    size_hint_y: None
                                    adaptive_height: True
                                    radius: [24]
                                    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: "30dp"
                                        spacing: "10dp"
                                        MDIcon:
                                            icon: "cash-plus"
                                            theme_text_color: "Custom"
                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'green')
                                            size_hint_x: None
                                            width: "24dp"
                                        MDLabel:
                                            text: app.tr("Aktif Gelirlerim", app.language)
                                            font_style: "Subtitle1"
                                            bold: True
                                            theme_text_color: "Primary"

                                    # Aynı satır bileşeni; gelirler tipik olarak az
                                    # sayıda olduğu için yükseklik pratikte hep
                                    # içeriğe uyar, ama üst sınır burada da var.
                                    PassthroughRecycleView:
                                        id: active_incomes_rv
                                        viewclass: "SubscriptionRow"
                                        size_hint_y: None
                                        height: min(income_rv_box.minimum_height, dp(400))

                                        RecycleBoxLayout:
                                            id: income_rv_box
                                            orientation: "vertical"
                                            default_size: None, dp(92)
                                            default_size_hint: 1, None
                                            size_hint_y: None
                                            height: self.minimum_height
                                            spacing: "10dp"

                                    # Boş durum etiketi buraya çizilir.
                                    MDBoxLayout:
                                        id: active_incomes_container
                                        orientation: "vertical"
                                        adaptive_height: True
                                        spacing: "10dp"

                                # FAZ 1: OLAĞANDIŞI HARCAMA UYARILARI
                                MDCard:
                                    id: unusual_spending_card
                                    elevation: 0
                                    line_color: ftheme.card_line(app.theme_cls.theme_style)
                                    orientation: "vertical"
                                    padding: "16dp"
                                    spacing: "10dp"
                                    size_hint_y: None
                                    adaptive_height: True
                                    radius: [24]
                                    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: "30dp"
                                        spacing: "10dp"
                                        MDIcon:
                                            icon: "alert-decagram-outline"
                                            theme_text_color: "Custom"
                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'red')
                                            size_hint_x: None
                                            width: "24dp"
                                        MDLabel:
                                            text: app.tr("Olağandışı Harcamalar", app.language)
                                            font_style: "Subtitle1"
                                            bold: True
                                            theme_text_color: "Primary"

                                    # Kartları InsightsMixin.render_anomalies çizer
                                    MDBoxLayout:
                                        id: anomalies_container
                                        orientation: "vertical"
                                        adaptive_height: True
                                        spacing: "10dp"



                                # YENİ: AKTİF BORÇLARIM KARTI
                                MDCard:
                                    id: active_debts_card
                                    elevation: 0
                                    line_color: ftheme.card_line(app.theme_cls.theme_style)
                                    orientation: "vertical"
                                    padding: "16dp"
                                    spacing: "10dp"
                                    size_hint_y: None
                                    # Kart içeriğe uyar: borç yokken yalnız başlık
                                    # ve "borcunuz bulunmuyor" satırı kadar yer
                                    # kaplar, sabit 220dp'lik boşluk bırakmaz.
                                    adaptive_height: True
                                    radius: [24, 24, 24, 24]
                                    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: "30dp"
                                        spacing: "10dp"
                                        MDIcon:
                                            icon: "credit-card-clock-outline"
                                            theme_text_color: "Custom"
                                            text_color: app.theme_cls.primary_color
                                            font_size: "24sp"
                                            size_hint_x: None
                                            width: "28dp"
                                            pos_hint: {"center_y": .5}
                                        MDLabel:
                                            text: app.tr("Aktif Borçlarım", app.language)
                                            font_style: "H6"
                                            bold: True
                                            
                                    # İçerik yüksekliğini alır; iki borç kartında
                                    # (2 × 140dp + 10dp aralık) sabitlenip içeride
                                    # kayar. Sınır satır yüksekliğinin katı: kart
                                    # eskisi gibi bir satırı ortadan kırpmaz.
                                    PassthroughScrollView:
                                        size_hint_y: None
                                        height: min(active_debts_container.minimum_height, dp(290))

                                        MDBoxLayout:
                                            id: active_debts_container
                                            orientation: "vertical"
                                            spacing: "10dp"
                                            adaptive_height: True

                                            MDLabel:
                                                text: app.tr("Henüz aktif bir borcunuz bulunmuyor.", app.language)
                                                theme_text_color: "Secondary"
                                                font_style: "Body2"
                                                halign: "center"
                                                # size_hint_y varsayılanı 1: kapsayıcının
                                                # minimum_height'ına 0 katkı verir ve boş
                                                # kart tamamen kapanırdı.
                                                size_hint_y: None
                                                height: "40dp"

                                # YENİ: YAKLAŞAN ÖDEMELER KARTI
                                MDCard:
                                    id: upcoming_payments_card
                                    elevation: 0
                                    line_color: ftheme.card_line(app.theme_cls.theme_style)
                                    orientation: "vertical"
                                    padding: "16dp"
                                    spacing: "10dp"
                                    size_hint_y: None
                                    adaptive_height: True
                                    radius: [24, 24, 24, 24]
                                    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: "30dp"
                                        spacing: "10dp"
                                        MDIcon:
                                            icon: "calendar-clock-outline"
                                            theme_text_color: "Custom"
                                            text_color: app.theme_cls.primary_color
                                            font_size: "24sp"
                                            size_hint_x: None
                                            width: "28dp"
                                            pos_hint: {"center_y": .5}
                                        MDLabel:
                                            text: app.tr("Yaklaşan Ödemeler", app.language)
                                            font_style: "H6"
                                            bold: True

                                    # İki ödeme kartı (2 × 100dp + 10dp aralık)
                                    # sığar, sonrası içeride kayar.
                                    PassthroughScrollView:
                                        size_hint_y: None
                                        height: min(upcoming_payments_container.minimum_height, dp(210))

                                        MDBoxLayout:
                                            id: upcoming_payments_container
                                            orientation: "vertical"
                                            spacing: "10dp"
                                            adaptive_height: True

                                            MDLabel:
                                                text: app.tr("Yaklaşan ödeme bulunmuyor.", app.language)
                                                theme_text_color: "Secondary"
                                                font_style: "Body2"
                                                halign: "center"
                                                size_hint_y: None
                                                height: "40dp"

                                # BEKLEYEN (İLERİ TARİHLİ) İŞLEMLER KARTI
                                # Bekleyen işlem yokken kart tamamen gizlenir
                                # (height/opacity 0): boş bir "hiç yok" kartı
                                # dashboard'da yer israfı olurdu. Görünürlüğü
                                # PendingMixin.render_pending_summary yönetir.
                                MDCard:
                                    id: pending_tx_card
                                    elevation: 0
                                    line_color: ftheme.card_line(app.theme_cls.theme_style)
                                    orientation: "vertical"
                                    padding: "16dp"
                                    spacing: "10dp"
                                    size_hint_y: None
                                    height: 0
                                    opacity: 0
                                    disabled: True
                                    radius: [24, 24, 24, 24]
                                    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)

                                    MDBoxLayout:
                                        size_hint_y: None
                                        height: "30dp"
                                        spacing: "10dp"
                                        MDIcon:
                                            icon: "clock-outline"
                                            theme_text_color: "Custom"
                                            text_color: app.theme_cls.primary_color
                                            font_size: "24sp"
                                            size_hint_x: None
                                            width: "28dp"
                                            pos_hint: {"center_y": .5}
                                        MDLabel:
                                            text: app.tr("Bekleyen İşlemler", app.language)
                                            font_style: "H6"
                                            bold: True

                                    MDLabel:
                                        id: pending_tx_summary
                                        text: ""
                                        theme_text_color: "Secondary"
                                        font_style: "Body2"
                                        size_hint_y: None
                                        height: "40dp"
                                        text_size: self.width, None

                                    MDRaisedButton:
                                        text: app.tr("BEKLEYENLERİ YÖNET", app.language)
                                        pos_hint: {"center_x": .5}
                                        elevation: 0
                                        on_release: app.open_pending_transactions()

                                # YENİ: SON İŞLEMLER LİSTESİ VE FİLTRESİ
                                MDBoxLayout:
                                    orientation: "vertical"
                                    size_hint_y: None
                                    height: self.minimum_height
                                    spacing: "10dp"
                                    padding: ["0dp", "15dp", "0dp", "0dp"]
                                    
                                    MDLabel:
                                        text: app.tr("Son İşlemler", app.language)
                                        font_style: "H6"
                                        bold: True
                                        size_hint_y: None
                                        height: "30dp"
                                        
                                    MDSegmentedControl:
                                        pos_hint: {"center_x": .5}
                                        size_hint_x: 1
                                        md_bg_color: ftheme.muted_bg(app.theme_cls.theme_style)
                                        segment_color: ftheme.card_bg(app.theme_cls.theme_style)
                                        on_active: app.load_recent_transactions(args[1].text)
                                        MDSegmentedControlItem:
                                            text: app.tr("Günlük", app.language)
                                        MDSegmentedControlItem:
                                            text: app.tr("Haftalık", app.language)
                                        MDSegmentedControlItem:
                                            text: app.tr("Aylık", app.language)
                                            
                                    PassthroughRecycleView:
                                        id: recent_transactions_list
                                        viewclass: RecycleListRow
                                        size_hint_y: None
                                        # Doluyken eski 400dp'lik görüntü alanı; dönemde
                                        # hiç işlem yokken kapanır (eskiden boş bir blok
                                        # bırakıyordu). Yüksekliği satır sayısıyla
                                        # ölçeklemek RecycleView'ın kendi yerleşimiyle
                                        # döngü kuruyor, o yüzden ikili durum kullanılıyor.
                                        height: dp(400) if self.data else 0

                                        RecycleBoxLayout:
                                            id: recent_tx_rv_box
                                            orientation: "vertical"
                                            default_size: None, dp(73)
                                            default_size_hint: 1, None
                                            size_hint_y: None
                                            height: self.minimum_height

                                    # Boş dönem metni; görünürlüğünü
                                    # _render_recent_transactions yönetir.
                                    MDLabel:
                                        id: recent_tx_empty_label
                                        text: app.tr("Bu dönemde işlem bulunmuyor.", app.language)
                                        theme_text_color: "Secondary"
                                        font_style: "Body2"
                                        halign: "center"
                                        size_hint_y: None
                                        height: 0
                                        opacity: 0

                # ==== 2. SEKME: VARLIKLARIM ====
                MDBottomNavigationItem:
                    name: "assets_tab"
                    text: app.tr("Varlıklarım", app.language)
                    icon: "finance"
                    # on_tab_press DEĞİL: o event animasyon başlarken tetiklenir ve
                    # ağır grafik/liste kurulumu kare atlatır. on_enter geçiş
                    # animasyonu bittikten sonra gelir; handler ayrıca Clock ile
                    # 0.1s nefes payı bırakır (bkz. TransactionMixin.on_assets_tab_enter).
                    on_enter: app.on_assets_tab_enter()
                    
                    MDFloatLayout:
                        MDBoxLayout:
                            orientation: "vertical"
                            MDTopAppBar:
                                title: app.tr("Varlıklarım", app.language)
                                elevation: 4
                            
                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "top"
                                
                                ScrollView:
                                    size_hint_x: 1
                                    
                                    MDBoxLayout:
                                        orientation: "vertical"
                                        adaptive_height: True
                                        padding: "24dp"
                                        spacing: "24dp"

                                        # --- DÖNEM ÖZET KARTI (3 metrik: Gelir | Gider | Net) ---
                                        MDBoxLayout:
                                            orientation: "horizontal"
                                            size_hint_y: None
                                            height: "96dp"
                                            spacing: "10dp"

                                            # Gelir kartı
                                            MDCard:
                                                elevation: 0
                                                line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                orientation: "vertical"
                                                padding: ["12dp", "10dp", "12dp", "10dp"]
                                                radius: [20, 20, 20, 20]
                                                md_bg_color: ftheme.tint_bg(app.theme_cls.theme_style, 'green')
                                                MDLabel:
                                                    text: app.tr("Gelir", app.language)
                                                    font_style: "Caption"
                                                    theme_text_color: "Secondary"
                                                    halign: "center"
                                                MDLabel:
                                                    id: period_income_label
                                                    text: app.tr("₺0,00", app.language)
                                                    font_style: "Subtitle2"
                                                    bold: True
                                                    halign: "center"
                                                    theme_text_color: "Custom"
                                                    text_color: ftheme.accent(app.theme_cls.theme_style, 'green')

                                            # Gider kartı
                                            MDCard:
                                                elevation: 0
                                                line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                orientation: "vertical"
                                                padding: ["12dp", "10dp", "12dp", "10dp"]
                                                radius: [20, 20, 20, 20]
                                                md_bg_color: ftheme.tint_bg(app.theme_cls.theme_style, 'red')
                                                MDLabel:
                                                    text: app.tr("Gider", app.language)
                                                    font_style: "Caption"
                                                    theme_text_color: "Secondary"
                                                    halign: "center"
                                                MDLabel:
                                                    id: period_expense_label
                                                    text: app.tr("₺0,00", app.language)
                                                    font_style: "Subtitle2"
                                                    bold: True
                                                    halign: "center"
                                                    theme_text_color: "Custom"
                                                    text_color: ftheme.accent(app.theme_cls.theme_style, 'red')

                                            # Net bakiye kartı
                                            MDCard:
                                                elevation: 0
                                                line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                orientation: "vertical"
                                                padding: ["12dp", "10dp", "12dp", "10dp"]
                                                radius: [20, 20, 20, 20]
                                                md_bg_color: ftheme.tint_bg(app.theme_cls.theme_style, 'blue')
                                                MDLabel:
                                                    text: app.tr("Net Bakiye", app.language)
                                                    font_style: "Caption"
                                                    theme_text_color: "Secondary"
                                                    halign: "center"
                                                MDLabel:
                                                    id: period_net_label
                                                    text: app.tr("₺0,00", app.language)
                                                    font_style: "Subtitle2"
                                                    bold: True
                                                    halign: "center"
                                                    theme_text_color: "Custom"
                                                    text_color: ftheme.accent(app.theme_cls.theme_style, 'blue')
                                    
                                        MDBoxLayout:
                                            orientation: "vertical"
                                            adaptive_height: True
                                            spacing: "16dp"
                                        
                                            MDBoxLayout:
                                                orientation: "horizontal"
                                                size_hint_y: None
                                                height: "30dp"
                                                MDLabel:
                                                    text: app.tr("Detaylar", app.language)
                                                    font_style: "H6"
                                                    bold: True

                                            # --- ZAMAN FİLTRESİ ---
                                            MDBoxLayout:
                                                orientation: "horizontal"
                                                size_hint_y: None
                                                height: "30dp"
                                                spacing: "8dp"
                                            
                                                MDFillRoundFlatButton:
                                                    id: btn_filter_today
                                                    text: app.tr("Bugün", app.language)
                                                    size_hint_x: 0.2
                                                    md_bg_color: app.theme_cls.primary_color
                                                    text_color: ftheme.on_primary(app.theme_cls.theme_style)
                                                    on_release: app.change_home_filter("Bugün")
                                                
                                                MDFillRoundFlatButton:
                                                    id: btn_filter_week
                                                    text: app.tr("1 Hafta", app.language)
                                                    size_hint_x: 0.2
                                                    md_bg_color: ftheme.muted_bg(app.theme_cls.theme_style)
                                                    text_color: ftheme.accent(app.theme_cls.theme_style, 'muted')
                                                    on_release: app.change_home_filter("1 Hafta")
                                                
                                                MDFillRoundFlatButton:
                                                    id: btn_filter_month
                                                    text: app.tr("1 Ay", app.language)
                                                    size_hint_x: 0.2
                                                    md_bg_color: ftheme.muted_bg(app.theme_cls.theme_style)
                                                    text_color: ftheme.accent(app.theme_cls.theme_style, 'muted')
                                                    on_release: app.change_home_filter("1 Ay")
                                                
                                                MDFillRoundFlatButton:
                                                    id: btn_filter_year
                                                    text: app.tr("1 Yıl", app.language)
                                                    size_hint_x: 0.2
                                                    md_bg_color: ftheme.muted_bg(app.theme_cls.theme_style)
                                                    text_color: ftheme.accent(app.theme_cls.theme_style, 'muted')
                                                    on_release: app.change_home_filter("1 Yıl")

                                                MDFillRoundFlatButton:
                                                    id: btn_filter_lifetime
                                                    text: app.tr("Hayat Boyu", app.language)
                                                    size_hint_x: 0.2
                                                    md_bg_color: ftheme.muted_bg(app.theme_cls.theme_style)
                                                    text_color: ftheme.accent(app.theme_cls.theme_style, 'muted')
                                                    on_release: app.change_home_filter("Hayat Boyu")
                                            
                                            MDBoxLayout:
                                                orientation: "vertical"
                                                spacing: "15dp"
                                                adaptive_height: True

                                                DashboardChartManager:
                                                    id: chart_master_box
                                                    orientation: "horizontal"
                                                    size_hint_x: 1
                                                    size_hint_y: None
                                                    height: "320dp"
                                                    padding: dp(8)
                                                    spacing: dp(10)

                                                    MDBoxLayout:
                                                        id: pie_chart_box
                                                        orientation: "vertical"
                                                        size_hint_x: 0.35
                                                        size_hint_y: 1
                                                        spacing: dp(4)

                                                    MDBoxLayout:
                                                        id: comparison_chart_box
                                                        orientation: "vertical"
                                                        size_hint_x: 0.65
                                                        size_hint_y: 1

                                                # --- TOPLAM VARLIK KARTI ---
                                                MDCard:
                                                    elevation: 0
                                                    line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                    id: total_wealth_card
                                                    size_hint_y: None
                                                    height: "120dp"
                                                    radius: [24, 24, 24, 24]
                                                    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style) if app.theme_cls.theme_style == "Light" else [0.15, 0.15, 0.15, 1]
                                                    padding: ["20dp", "14dp", "20dp", "14dp"]

                                                    MDBoxLayout:
                                                        orientation: "vertical"
                                                        spacing: "6dp"

                                                        MDLabel:
                                                            text: app.tr("Toplam Varlık", app.language)
                                                            font_style: "Caption"
                                                            theme_text_color: "Secondary"
                                                            halign: "center"
                                                            size_hint_y: None
                                                            height: "18dp"

                                                        MDBoxLayout:
                                                            orientation: "horizontal"
                                                            adaptive_width: True
                                                            pos_hint: {"center_x": .5}
                                                            spacing: "12dp"
                                                            size_hint_y: None
                                                            height: "42dp"

                                                            MDLabel:
                                                                id: wealth_amount_label
                                                                text: app.tr("₺---", app.language)
                                                                font_style: "H5"
                                                                bold: True
                                                                adaptive_width: True
                                                                pos_hint: {"center_y": .5}
                                                                theme_text_color: "Primary"
                                                                halign: "center"

                                                            MDIconButton:
                                                                id: wealth_eye_btn
                                                                icon: "eye-outline"
                                                                theme_text_color: "Secondary"
                                                                icon_size: "22dp"
                                                                pos_hint: {"center_y": .5}
                                                                on_release: app.toggle_wealth_visibility()

                                                        MDLabel:
                                                            id: wealth_daily_pnl_label
                                                            text: app.tr("Veriler yükleniyor...", app.language)
                                                            font_style: "Caption"
                                                            halign: "center"
                                                            size_hint_y: None
                                                            height: "18dp"
                                                            theme_text_color: "Custom"
                                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'muted')

                                                MDBoxLayout:
                                                    id: goals_container
                                                    orientation: "vertical"
                                                    spacing: "24dp"
                                                    padding: ["16dp", "8dp", "16dp", "16dp"]
                                                    adaptive_height: True

                                                # AKTİF VARLIKLARIM KARTI
                                                MDCard:
                                                    elevation: 0
                                                    line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                    orientation: "vertical"
                                                    padding: "16dp"
                                                    spacing: "10dp"
                                                    size_hint_y: None
                                                    # Yükseklik varlık sayısına göre
                                                    # AssetMixin.render_active_assets içinde
                                                    # ayarlanır; liste kartı doldurduğu için
                                                    # boş alan kalmaz.
                                                    height: "280dp"
                                                    radius: [24, 24, 24, 24]
                                                    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style) if app.theme_cls.theme_style == "Light" else [0.15, 0.15, 0.15, 1]

                                                    MDBoxLayout:
                                                        size_hint_y: None
                                                        height: "36dp"
                                                        spacing: "10dp"
                                                        MDIcon:
                                                            icon: "chart-line"
                                                            size_hint_x: None
                                                            width: "28dp"
                                                            theme_text_color: "Custom"
                                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'green')
                                                            font_size: "24sp"
                                                            pos_hint: {"center_y": .5}
                                                        MDLabel:
                                                            text: app.tr("Aktif Varlıklarım", app.language)
                                                            font_style: "H6"
                                                            bold: True
                                                            pos_hint: {"center_y": .5}
                                                        MDLabel:
                                                            id: asset_prices_updated_label
                                                            text: app.tr("Son Güncelleme: —", app.language)
                                                            font_style: "Caption"
                                                            theme_text_color: "Secondary"
                                                            halign: "right"
                                                            pos_hint: {"center_y": .5}
                                                        MDIconButton:
                                                            icon: "refresh"
                                                            tooltip_text: app.tr("Manuel Yenile", app.language)
                                                            theme_text_color: "Custom"
                                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'green')
                                                            icon_size: "28dp"
                                                            pos_hint: {"center_y": .5}
                                                            on_release: app.refresh_asset_prices()
                                                        MDIconButton:
                                                            id: add_asset_btn
                                                            icon: "plus-circle"
                                                            theme_text_color: "Custom"
                                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'green')
                                                            icon_size: "28dp"
                                                            pos_hint: {"center_y": .5}
                                                            on_release: app.show_add_asset_dialog()

                                                    PassthroughScrollView:
                                                        MDBoxLayout:
                                                            id: active_assets_container
                                                            orientation: "vertical"
                                                            spacing: "8dp"
                                                            adaptive_height: True

                                                            MDLabel:
                                                                text: app.tr("Yükleniyor...", app.language)
                                                                theme_text_color: "Hint"
                                                                font_style: "Body2"
                                                                halign: "center"
                                                                size_hint_y: None
                                                                height: "40dp"

                                                # VARLIK GEÇMİŞİ KARTI
                                                MDCard:
                                                    elevation: 0
                                                    line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                    orientation: "vertical"
                                                    padding: "16dp"
                                                    spacing: "10dp"
                                                    size_hint_y: None
                                                    # Geçmiş boşken kart yalnız başlık ve
                                                    # boş durum satırı kadar yer kaplar;
                                                    # işlem varken eski 320dp'lik liste
                                                    # yüksekliğini korur.
                                                    height: "320dp" if asset_history_list.data else "108dp"
                                                    radius: [24, 24, 24, 24]
                                                    md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)

                                                    MDBoxLayout:
                                                        size_hint_y: None
                                                        height: "36dp"
                                                        spacing: "10dp"
                                                        MDIcon:
                                                            icon: "history"
                                                            theme_text_color: "Custom"
                                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'amber')
                                                            font_size: "24sp"
                                                            size_hint_x: None
                                                            width: "28dp"
                                                            pos_hint: {"center_y": .5}
                                                        MDLabel:
                                                            text: app.tr("Varlık Geçmişi", app.language)
                                                            font_style: "H6"
                                                            bold: True
                                                            pos_hint: {"center_y": .5}

                                                    # Liste kartın kalan alanını doldurur.
                                                    # Yüksekliği İÇERİKTEN türetmek (satır
                                                    # sayısı ya da RecycleBoxLayout.minimum_height)
                                                    # denendi ve geri alındı: RecycleView kendi
                                                    # yerleşimini kendi boyutuna göre yapıyor,
                                                    # boyutu da içeriğe bağlanınca satırlar kartın
                                                    # dışına — alttaki kartın üstüne — çiziliyordu.
                                                    # Boş durum kartın kendi yüksekliğinde çözülür.
                                                    PassthroughRecycleView:
                                                        id: asset_history_list
                                                        viewclass: RecycleListRow

                                                        RecycleBoxLayout:
                                                            id: asset_history_rv_box
                                                            orientation: "vertical"
                                                            default_size: None, dp(73)
                                                            default_size_hint: 1, None
                                                            size_hint_y: None
                                                            height: self.minimum_height

                                                    MDLabel:
                                                        id: asset_history_empty_label
                                                        text: app.tr("Henüz varlık işlemi bulunmuyor.", app.language)
                                                        theme_text_color: "Secondary"
                                                        font_style: "Body2"
                                                        halign: "center"
                                                        size_hint_y: None
                                                        height: 0
                                                        opacity: 0

                                                Widget:
                                                    size_hint: None, None
                                                    size: 0, 0
                                                    opacity: 0
                                                    HorizontalBarChart:
                                                        id: bar_chart

                                                MDGridLayout:
                                                    id: metrics_grid
                                                    size_hint_x: 1
                                                    cols: 2
                                                    spacing: "16dp"
                                                    adaptive_height: True
                                                    padding: "16dp"

                                                    MDCard:
                                                        elevation: 0
                                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                        id: metric_card_income
                                                        orientation: "vertical"
                                                        padding: "16dp"
                                                        size_hint_y: None
                                                        height: "120dp"
                                                        md_bg_color: ftheme.tint_bg(app.theme_cls.theme_style, 'green')
                                                        # Statik placeholder: kart yerinde ve görünür başlar,
                                                        # veri gelince yalnız etiket metinleri güncellenir.
                                                        MDIcon:
                                                            icon: "trending-up"
                                                            theme_text_color: "Custom"
                                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'green')
                                                        MDLabel:
                                                            text: app.tr("Toplam Gelir", app.language)
                                                            font_style: "Caption"
                                                        MDLabel:
                                                            id: metric_val_income
                                                            text: app.tr("0 ₺", app.language)
                                                            bold: True
                                                
                                                    MDCard:
                                                        elevation: 0
                                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                        id: metric_card_expense
                                                        orientation: "vertical"
                                                        padding: "16dp"
                                                        size_hint_y: None
                                                        height: "120dp"
                                                        md_bg_color: ftheme.tint_bg(app.theme_cls.theme_style, 'red')
                                                        MDIcon:
                                                            icon: "trending-down"
                                                            theme_text_color: "Custom"
                                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'red')
                                                        MDLabel:
                                                            text: app.tr("Toplam Gider", app.language)
                                                            font_style: "Caption"
                                                        MDLabel:
                                                            id: metric_val_expense
                                                            text: app.tr("0 ₺", app.language)
                                                            bold: True

                                                    MDCard:
                                                        elevation: 0
                                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                        id: metric_card_savings
                                                        orientation: "vertical"
                                                        padding: "16dp"
                                                        size_hint_y: None
                                                        height: "120dp"
                                                        md_bg_color: ftheme.tint_bg(app.theme_cls.theme_style, 'blue')
                                                        MDIcon:
                                                            icon: "piggy-bank"
                                                            theme_text_color: "Custom"
                                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'blue')
                                                        MDLabel:
                                                            text: app.tr("Tasarruf Oranı", app.language)
                                                            font_style: "Caption"
                                                        MDLabel:
                                                            id: metric_val_savings
                                                            text: app.tr("%0", app.language)
                                                            bold: True

                                                    MDCard:
                                                        elevation: 0
                                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                        id: metric_card_trend
                                                        orientation: "vertical"
                                                        padding: "16dp"
                                                        size_hint_y: None
                                                        height: "120dp"
                                                        md_bg_color: ftheme.tint_bg(app.theme_cls.theme_style, 'amber')
                                                        MDIcon:
                                                            icon: "chart-timeline-variant"
                                                            theme_text_color: "Custom"
                                                            text_color: ftheme.accent(app.theme_cls.theme_style, 'amber')
                                                        MDLabel:
                                                            text: app.tr("Aylık Gelir Amacı", app.language)
                                                            font_style: "Caption"
                                                            theme_text_color: "Secondary"
                                                        MDLabel:
                                                            id: metric_val_trend
                                                            text: app.tr("—", app.language)
                                                            font_style: "Subtitle2"
                                                            theme_text_color: "Primary"
                        
                        MDFloatingActionButton:
                            icon: "plus"
                            pos_hint: {"right": 0.95, "y": 0.05}
                            on_release: app.show_add_dialog()

                        ConfettiWidget:
                            id: confetti_overlay
                            size_hint: 1, 1
                            pos_hint: {"x": 0, "y": 0}

                # ==== YENİ SEKME: HESAPLARIM / KARTLARIM ====
                MDBottomNavigationItem:
                    name: "accounts_tab"
                    text: app.tr("Kartlarım", app.language)
                    icon: "credit-card-multiple-outline"
                    # Animasyon bittikten sonra + 0.1s Clock gecikmesiyle yüklenir
                    # (bkz. AccountMixin.on_accounts_tab_enter) — geçiş takılmasın.
                    on_enter: app.on_accounts_tab_enter()
                    
                    MDFloatLayout:
                        MDBoxLayout:
                            orientation: "vertical"
                            MDTopAppBar:
                                title: app.tr("Kartlarım", app.language)
                                elevation: 4
                            
                            AnchorLayout:
                                anchor_x: "center"
                                anchor_y: "top"
                                
                                ScrollView:
                                    size_hint_x: 1
                                    
                                    MDBoxLayout:
                                        orientation: "vertical"
                                        adaptive_height: True
                                        padding: "24dp"
                                        spacing: "24dp"

                                        # --- DÖNEM ÖZET KARTI (3 metrik) ---
                                        MDBoxLayout:
                                            orientation: "horizontal"
                                            size_hint_y: None
                                            height: "96dp"
                                            spacing: "10dp"

                                            # Nakit
                                            MDCard:
                                                elevation: 0
                                                line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                orientation: "vertical"
                                                padding: ["12dp", "10dp", "12dp", "10dp"]
                                                radius: [20, 20, 20, 20]
                                                md_bg_color: ftheme.tint_bg(app.theme_cls.theme_style, 'green')
                                                MDLabel:
                                                    text: app.tr("Nakit", app.language)
                                                    font_style: "Caption"
                                                    theme_text_color: "Secondary"
                                                    halign: "center"
                                                MDLabel:
                                                    id: accounts_cash_label
                                                    text: app.tr("₺0,00", app.language)
                                                    font_style: "Subtitle2"
                                                    bold: True
                                                    halign: "center"
                                                    theme_text_color: "Custom"
                                                    text_color: ftheme.accent(app.theme_cls.theme_style, 'green')

                                            # Kart Borcu
                                            MDCard:
                                                elevation: 0
                                                line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                orientation: "vertical"
                                                padding: ["12dp", "10dp", "12dp", "10dp"]
                                                radius: [20, 20, 20, 20]
                                                md_bg_color: ftheme.tint_bg(app.theme_cls.theme_style, 'red')
                                                MDLabel:
                                                    text: app.tr("Kart Borcu", app.language)
                                                    font_style: "Caption"
                                                    theme_text_color: "Secondary"
                                                    halign: "center"
                                                MDLabel:
                                                    id: accounts_debt_label
                                                    text: app.tr("₺0,00", app.language)
                                                    font_style: "Subtitle2"
                                                    bold: True
                                                    halign: "center"
                                                    theme_text_color: "Custom"
                                                    text_color: ftheme.accent(app.theme_cls.theme_style, 'red')

                                            # Net Servet
                                            MDCard:
                                                elevation: 0
                                                line_color: ftheme.card_line(app.theme_cls.theme_style)
                                                orientation: "vertical"
                                                padding: ["12dp", "10dp", "12dp", "10dp"]
                                                radius: [20, 20, 20, 20]
                                                md_bg_color: ftheme.tint_bg(app.theme_cls.theme_style, 'blue')
                                                MDLabel:
                                                    text: app.tr("Net Servet", app.language)
                                                    font_style: "Caption"
                                                    theme_text_color: "Secondary"
                                                    halign: "center"
                                                MDLabel:
                                                    id: accounts_net_label
                                                    text: app.tr("₺0,00", app.language)
                                                    font_style: "Subtitle2"
                                                    bold: True
                                                    halign: "center"
                                                    theme_text_color: "Primary"

                                        MDBoxLayout:
                                            orientation: "horizontal"
                                            adaptive_height: True
                                            MDLabel:
                                                text: app.tr("Kartlarım", app.language)
                                                font_style: "H6"
                                                bold: True
                                                size_hint_y: None
                                                height: self.texture_size[1]
                                            MDRaisedButton:
                                                text: app.tr("+ EKLE", app.language)
                                                elevation: 0
                                                on_release: app.open_add_account_dialog()

                                        PassthroughScrollView:
                                            size_hint_y: None
                                            # Kart yüksekliği ölçüldü: 3 hareket
                                            # satırlı kredi kartı 567dp'ye çıkıyor
                                            # ("Kart Kullanım Özeti" + Son Hareketler
                                            # eklendikten sonra). 500dp'de kartın
                                            # alt kısmı kırpılıyordu.
                                            #
                                            # SABİT KALIYOR. Yüksekliği içeriğe
                                            # bağlamak (kart yokken şerit kapansın
                                            # diye) denendi ve ÖLÇÜLEREK geri alındı:
                                            # scripts/dev/verify_tab_scrolling.py
                                            # bu sekmede sürüklemeyi ölü buldu
                                            # (#95'in koşusunda içerik 1056dp,
                                            # sürükleme ✓; bu bağlamayla 1031dp,
                                            # sürükleme ✗). Şerit kısalınca altındaki
                                            # kartlar sürükleme noktasına geliyor ve
                                            # MDCard dokunuşu yutuyor — yani boş
                                            # kartın yerini kazanmak, bu sekmenin
                                            # kaydırılabilmesine mal oluyordu.
                                            height: "620dp"
                                            do_scroll_y: False
                                            do_scroll_x: True
                                            # SAYFA KAYDIRMASINI YUTMASIN.
                                            # Bu yatay şerit, sayfanın DİKEY
                                            # ScrollView'ının içinde duruyor ve
                                            # 620dp yüksekliğiyle görünür alanın
                                            # TAMAMINDAN büyük. Kivy iç içe
                                            # ScrollView'larda dokunuşu ÖNCE
                                            # çocuğa soruyor (scrollview.py:697,
                                            # `dispatch_children('on_scroll_start')`)
                                            # ve sürükleme dalında çocuk, kendi
                                            # ekseninde kayacak içerik olup
                                            # olmadığına BAKMADAN sahipleniyor
                                            # (aynı dosya: `self._touch = touch`
                                            # ... `return True`). Sonuç ölçüldü:
                                            # şeridin üzerinde sayfa hiç
                                            # kaymıyordu — yani "Hesaplarım"
                                            # bölümüne ulaşmak imkânsızdı;
                                            # yalnızca en üstteki dar özet
                                            # bandından kaydırılabiliyordu.
                                            #
                                            # `scroll_type: ["bars"]` bu davranışı
                                            # kaynağın kendi kapısından çeviriyor
                                            # (scrollview.py:798): dokunuş çubuğun
                                            # üzerinde DEĞİLSE ScrollView onu
                                            # sahiplenmiyor, `simulate_touch_down`
                                            # ile geçiriyor. Kartlar yatayda
                                            # çubuktan kaydırılır; dikey hareket
                                            # sayfaya ulaşır.
                                            #
                                            # `bar_width` bu yüzden 0 OLAMAZ:
                                            # 0 genişlikte çubuk hiçbir dokunuşu
                                            # yakalayamaz ve şerit tamamen
                                            # kaydırılamaz hâle gelirdi.
                                            #
                                            # TEKERLEK ayrı bir yol: `bars` kapısından
                                            # ÖNCE çalıştığı için `scroll_type` onu
                                            # etkilemiyor. Onu PassthroughScrollView
                                            # kapatıyor (ui/components.py) — dikey
                                            # kaydırma yapmayan bu şerit dikey tekerleği
                                            # sayfaya bırakır.
                                            scroll_type: ["bars"]
                                            bar_width: "6dp"
                                            bar_margin: "2dp"
                                            MDBoxLayout:
                                                id: cards_container
                                                orientation: "horizontal"
                                                adaptive_width: True
                                                spacing: "16dp"
                                                padding: ["4dp", "8dp", "4dp", "8dp"]

                                        MDBoxLayout:
                                            orientation: "horizontal"
                                            adaptive_height: True
                                            padding: ["0dp", "16dp", "0dp", "0dp"]
                                            MDLabel:
                                                text: app.tr("Hesaplarım", app.language)
                                                font_style: "H6"
                                                bold: True
                                                size_hint_y: None
                                                height: self.texture_size[1]

                                        MDGridLayout:
                                            id: accounts_container
                                            cols: 2 if root.width > dp(600) else 1
                                            adaptive_height: True
                                            spacing: "12dp"
                                            
                        MDFloatingActionButton:
                            icon: "credit-card-plus"
                            md_bg_color: app.theme_cls.primary_color
                            pos_hint: {"right": 0.95, "y": 0.05}
                            on_release: app.open_add_account_dialog()

                # ==== 3. SEKME: ARAÇLAR ====
                MDBottomNavigationItem:
                    name: "tools_tab"
                    text: app.tr("Araçlar", app.language)
                    icon: "tools"
                    
                    MDBoxLayout:
                        orientation: "vertical"
                        MDTopAppBar:
                            title: app.tr("Hesaplama Araçları", app.language)
                            elevation: 4
                        
                        ScrollView:
                            MDBoxLayout:
                                orientation: 'vertical'
                                spacing: '20dp'
                                padding: '20dp'
                                adaptive_height: True
                                MDGridLayout:
                                    cols: 2
                                    padding: "20dp"
                                    spacing: "20dp"
                                    size_hint_y: None
                                    height: self.minimum_height

                                    # AYLIK BÜTÇE KARESİ — diğer araçlarla birebir
                                    # aynı 140dp kutu; tıklanınca planlayıcı
                                    # diyaloğu açılır (app.show_budget_planner).
                                    # Panel artık ızgaranın üstünde tam genişlikte
                                    # durmuyor; kullanıcı isteği bu kareydi.
                                    MDCard:
                                        id: budget_tool_card
                                        elevation: 0
                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                        size_hint_y: None
                                        height: "140dp"
                                        radius: [24]
                                        md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)
                                        orientation: "vertical"
                                        padding: "20dp"
                                        spacing: "10dp"
                                        ripple_behavior: True
                                        # Gerçek tıklama main.py::on_start'ta bind_card_tap ile kuruluyor —
                                        # bkz. calendar_tool_card'daki DÜZELTME notu (on_release burada
                                        # hiç dispatch edilmiyordu, MDCard ButtonBehavior miras almıyor).
                                        MDFloatLayout:
                                            size_hint: None, None
                                            size: "48dp", "48dp"
                                            canvas.before:
                                                Color:
                                                    rgba: (0.45, 0.15, 0.62, 0.15)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [24]
                                            MDIcon:
                                                icon: "calendar-month"
                                                font_size: "24sp"
                                                theme_text_color: "Custom"
                                                text_color: ftheme.accent(app.theme_cls.theme_style, 'purple')
                                                pos_hint: {"center_x": .5, "center_y": .5}
                                        Widget:
                                        MDLabel:
                                            text: app.tr("Aylık\nBütçe", app.language)
                                            font_style: "Subtitle1"
                                            bold: True

                                    MDCard:
                                        id: calendar_tool_card
                                        elevation: 0
                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                        size_hint_y: None
                                        height: "140dp"
                                        radius: [24]
                                        md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)
                                        orientation: "vertical"
                                        padding: "20dp"
                                        spacing: "10dp"
                                        ripple_behavior: True
                                        # DÜZELTME: `on_release:` burada SESSİZCE hiç ateşlenmiyordu —
                                        # MDCard'ın ripple_behavior'ı yalnızca GÖRSEL efekt, ButtonBehavior'ı
                                        # miras almıyor (bkz. ui/theme.py::bind_card_tap docstring'i; aynı
                                        # kökten "Daha fazla seçenek" ve tutar alanı hataları). Gerçek
                                        # tıklama main.py::on_start içinde bind_card_tap ile kuruluyor.
                                        MDFloatLayout:
                                            size_hint: None, None
                                            size: "48dp", "48dp"
                                            canvas.before:
                                                Color:
                                                    rgba: (0.1, 0.6, 0.9, 0.15)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [24]
                                            MDIcon:
                                                icon: "calendar-search"
                                                font_size: "24sp"
                                                theme_text_color: "Custom"
                                                text_color: ftheme.accent(app.theme_cls.theme_style, 'blue')
                                                pos_hint: {"center_x": .5, "center_y": .5}
                                        Widget:
                                        MDLabel:
                                            text: app.tr("Takvim", app.language)
                                            font_style: "Subtitle1"
                                            bold: True

                                    MDCard:
                                        id: calc_basic_tool_card
                                        elevation: 0
                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                        size_hint_y: None
                                        height: "140dp"
                                        radius: [24]
                                        md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)
                                        orientation: "vertical"
                                        padding: "20dp"
                                        spacing: "10dp"
                                        ripple_behavior: True
                                        MDFloatLayout:
                                            size_hint: None, None
                                            size: "48dp", "48dp"
                                            canvas.before:
                                                Color:
                                                    rgba: (0.18, 0.8, 0.25, 0.15)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [24]
                                            MDIcon:
                                                icon: "calculator-variant"
                                                font_size: "24sp"
                                                theme_text_color: "Custom"
                                                text_color: ftheme.accent(app.theme_cls.theme_style, 'green')
                                                pos_hint: {"center_x": .5, "center_y": .5}
                                        Widget:
                                        MDLabel:
                                            text: app.tr("Hesap\nMakinesi", app.language)
                                            font_style: "Subtitle1"
                                            bold: True

                                    MDCard:
                                        id: calc_interest_tool_card
                                        elevation: 0
                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                        size_hint_y: None
                                        height: "140dp"
                                        radius: [24]
                                        md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)
                                        orientation: "vertical"
                                        padding: "20dp"
                                        spacing: "10dp"
                                        ripple_behavior: True
                                        MDFloatLayout:
                                            size_hint: None, None
                                            size: "48dp", "48dp"
                                            canvas.before:
                                                Color:
                                                    rgba: (0.13, 0.59, 0.95, 0.15)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [24]
                                            MDIcon:
                                                icon: "percent-outline"
                                                font_size: "24sp"
                                                theme_text_color: "Custom"
                                                text_color: ftheme.accent(app.theme_cls.theme_style, 'blue')
                                                pos_hint: {"center_x": .5, "center_y": .5}
                                        Widget:
                                        MDLabel:
                                            text: app.tr("Faiz\nGetirisi", app.language)
                                            font_style: "Subtitle1"
                                            bold: True

                                    MDCard:
                                        id: calc_compound_tool_card
                                        elevation: 0
                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                        size_hint_y: None
                                        height: "140dp"
                                        radius: [24]
                                        md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)
                                        orientation: "vertical"
                                        padding: "20dp"
                                        spacing: "10dp"
                                        ripple_behavior: True
                                        MDFloatLayout:
                                            size_hint: None, None
                                            size: "48dp", "48dp"
                                            canvas.before:
                                                Color:
                                                    rgba: (0.6, 0.2, 0.8, 0.15)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [24]
                                            MDIcon:
                                                icon: "trending-up"
                                                font_size: "24sp"
                                                theme_text_color: "Custom"
                                                text_color: ftheme.accent(app.theme_cls.theme_style, 'purple')
                                                pos_hint: {"center_x": .5, "center_y": .5}
                                        Widget:
                                        MDLabel:
                                            text: app.tr("Bileşik\nFaiz", app.language)
                                            font_style: "Subtitle1"
                                            bold: True

                                    MDCard:
                                        id: calc_loan_tool_card
                                        elevation: 0
                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                        size_hint_y: None
                                        height: "140dp"
                                        radius: [24]
                                        md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)
                                        orientation: "vertical"
                                        padding: "20dp"
                                        spacing: "10dp"
                                        ripple_behavior: True
                                        MDFloatLayout:
                                            size_hint: None, None
                                            size: "48dp", "48dp"
                                            canvas.before:
                                                Color:
                                                    rgba: (0.9, 0.2, 0.3, 0.15)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [24]
                                            MDIcon:
                                                icon: "bank"
                                                font_size: "24sp"
                                                theme_text_color: "Custom"
                                                text_color: ftheme.accent(app.theme_cls.theme_style, 'red')
                                                pos_hint: {"center_x": .5, "center_y": .5}
                                        Widget:
                                        MDLabel:
                                            text: app.tr("Kredi\nHesaplama", app.language)
                                            font_style: "Subtitle1"
                                            bold: True

                                    MDCard:
                                        id: calc_savings_goal_tool_card
                                        elevation: 0
                                        line_color: ftheme.card_line(app.theme_cls.theme_style)
                                        size_hint_y: None
                                        height: "140dp"
                                        radius: [24]
                                        md_bg_color: ftheme.card_bg(app.theme_cls.theme_style)
                                        orientation: "vertical"
                                        padding: "20dp"
                                        spacing: "10dp"
                                        ripple_behavior: True
                                        MDFloatLayout:
                                            size_hint: None, None
                                            size: "48dp", "48dp"
                                            canvas.before:
                                                Color:
                                                    rgba: (0.95, 0.6, 0.1, 0.15)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [24]
                                            MDIcon:
                                                icon: "bullseye-arrow"
                                                font_size: "24sp"
                                                theme_text_color: "Custom"
                                                text_color: ftheme.accent(app.theme_cls.theme_style, 'amber')
                                                pos_hint: {"center_x": .5, "center_y": .5}
                                        Widget:
                                        MDLabel:
                                            text: app.tr("Birikim\nHedefi", app.language)
                                            font_style: "Subtitle1"
                                            bold: True

                                    MDCard:
                                        id: scenario_tool_card
                                        elevation: 0

                                                    text: "Detaylar"
                                                    font_style: "H6"
                                                    bold: True

                                            # --- ZAMAN FİLTRESİ ---
                                            MDBoxLayout:
                                                orientation: "horizontal"
                                                size_hint_y: None
                                                height: "30dp"
                                                spacing: "8dp"
                                            
                                                MDFillRoundFlatButton:
                                                    id: btn_filter_today
                                                    text: "Bugün"
                                                    size_hint_x: 0.2
                                                    md_bg_color: app.theme_cls.primary_color
                                                    text_color: 1, 1, 1, 1

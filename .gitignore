# Çalışma zamanı verileri — kullanıcının kişisel finans verisi repoya girmemeli
finance.db
finance.db.bak*
savings_goals.json
archlence_config.json
legacy_config_backup.json
crash.log
db_backups/

# Şifreleme anahtarı — asla commit edilmemeli
security/secret.key

# Python / araç artıkları
__pycache__/
*.pyc
.venv/
venv/
.vscode/

# PyInstaller çıktıları — CI her seferinde yeniden üretir, repoya girmemeli
build/
dist/
*.build/

# AppImage paketleme için CI'nin (ve yerel test derlemesinin) topladığı
# geçici AppDir — build-linux.yml her seferinde yeniden oluşturur
AppDir/
*.AppImage

# makepkg (PKGBUILD) çıktıları. Bunlar izlenmediği hâlde ağaçta kaldıklarında
# TARAYAN ARAÇLARI yanıltıyorlar: `src/` altına açılan AppImage, KivyMD'nin
# kendi kaynağının bir kopyasını taşıyor ve hem tests/test_icon_names.py hem
# scripts/audit_exception_handlers.py bunu PROJE KAYNAĞI sanıp yanlış pozitif
# üretti (ikisi de ayrıca `AppDir` hariç tutacak şekilde düzeltildi).
pkg/
src/
*.pkg.tar.zst

# Inno Setup çıktısı — installer/archlence.iss'ten CI her seferinde üretir
installer_output/

# IDE ajanlarının (Antigravity vb.) bıraktığı tek seferlik test çıktıları
test_output*.txt
test_exit*.txt
discover_output*.txt

# graphify çıktısı — makineye özgü mutlak yollar ve üretilmiş graf verisi içerir
graphify-out/

# Varlık Geçmişi için çalışma zamanında indirilen kripto/döviz logoları
assets/logo_cache/

# Abonelik kartları için çalışma zamanında indirilen marka logoları
assets/brand_icon_cache/

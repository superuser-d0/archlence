# Runtime data must never be committed.
finance.db
finance.db.bak*
savings_goals.json
archlence_config.json
legacy_config_backup.json
crash.log
db_backups/

# Encryption keys must never be committed.
security/secret.key

# Python and development-tool artifacts
__pycache__/
*.pyc
.venv/
venv/
.vscode/
.claude/

# Build outputs
build/
dist/
*.build/

# Linux packaging outputs
AppDir/
*.AppImage
pkg/
src/
*.pkg.tar.zst

# Windows packaging outputs
installer_output/

# Test and audit artifacts
test_output*.txt
test_exit*.txt
discover_output*.txt

# Machine-specific generated graphs
graphify-out/

# Runtime-downloaded images
assets/logo_cache/
assets/brand_icon_cache/
